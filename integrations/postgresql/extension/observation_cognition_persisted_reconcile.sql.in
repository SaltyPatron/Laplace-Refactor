-- Historical 1.0.1 packages existed before persisted prompt/cognition objects were
-- added to the 1.0.0 -> 1.0.1 source migration. A cluster can therefore truthfully
-- report extversion=1.0.1 while missing these later 1.0.1 objects. Reconcile that
-- exact historical state before the 1.0.1 -> 1.0.2 product-cognition delta runs.
-- Existing compatible objects are retained; incompatible composite shapes fail.

CREATE OR REPLACE FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.trajectory_entity_ids(bytea)
RETURNS bytea[] AS 'MODULE_PATHNAME', 'laplace_pg_trajectory_entity_ids'
LANGUAGE C IMMUTABLE STRICT PARALLEL SAFE;
REVOKE EXECUTE ON FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.trajectory_entity_ids(bytea) FROM PUBLIC;

CREATE INDEX IF NOT EXISTS physicality_entity_lookup_idx
ON @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.physicality(entity_id, physicality_id);
CREATE INDEX IF NOT EXISTS physicality_constituent_lookup_idx
ON @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.physicality
USING gin (@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.trajectory_entity_ids(trajectory))
WITH (fastupdate = off)
WHERE physicality_type = 1;

DO $laplace_persisted_types$
DECLARE
    names text[];
BEGIN
    IF pg_catalog.to_regtype('@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_answer') IS NULL THEN
        EXECUTE $ddl$
            CREATE TYPE @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_answer AS (
                entity_id bytea, relation_id bytea, path_id bytea, terminal_state_id bytea,
                total_cost numeric(20,0), transition_count numeric(20,0),
                independent_evidence_root_count numeric(20,0), relation_family integer,
                source_layer integer, direction integer, rank integer, flags integer)
        $ddl$;
    ELSE
        SELECT pg_catalog.array_agg(a.attname::text ORDER BY a.attnum)
          INTO names
          FROM pg_catalog.pg_attribute AS a
         WHERE a.attrelid = '@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_answer'::pg_catalog.regclass
           AND a.attnum > 0 AND NOT a.attisdropped;
        IF names <> ARRAY['entity_id','relation_id','path_id','terminal_state_id','total_cost',
                           'transition_count','independent_evidence_root_count','relation_family',
                           'source_layer','direction','rank','flags']::text[] THEN
            RAISE EXCEPTION 'incompatible cognition_observation_answer composite on 1.0.1 cluster';
        END IF;
    END IF;

    IF pg_catalog.to_regtype('@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_persisted_result') IS NULL THEN
        EXECUTE $ddl$
            CREATE TYPE @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_persisted_result AS (
                execution @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_result,
                answers @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_answer[],
                provider_rows_fetched numeric(20,0), provider_trajectory_bytes numeric(20,0),
                provider_batch_count numeric(20,0), provider_readset_id bytea)
        $ddl$;
    ELSE
        SELECT pg_catalog.array_agg(a.attname::text ORDER BY a.attnum)
          INTO names
          FROM pg_catalog.pg_attribute AS a
         WHERE a.attrelid = '@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_persisted_result'::pg_catalog.regclass
           AND a.attnum > 0 AND NOT a.attisdropped;
        IF names <> ARRAY['execution','answers','provider_rows_fetched','provider_trajectory_bytes',
                           'provider_batch_count','provider_readset_id']::text[] THEN
            RAISE EXCEPTION 'incompatible cognition_observation_persisted_result composite on 1.0.1 cluster';
        END IF;
    END IF;

    IF pg_catalog.to_regtype('@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_scope') IS NULL THEN
        EXECUTE $ddl$
            CREATE TYPE @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_scope AS (
                source_fingerprint bytea,
                content_recipe_fingerprint bytea,
                calculation_recipe_fingerprint bytea,
                geometry_epoch bytea,
                occurrence_context_fingerprint bytea,
                principal_fingerprint bytea,
                session_fingerprint bytea,
                discourse_id bytea,
                world_id bytea,
                time_fingerprint bytea,
                turn_ordinal numeric(20,0),
                turn_flags integer,
                source_ordinal_base numeric(20,0),
                preferred_batch_bytes numeric(20,0))
        $ddl$;
    ELSE
        SELECT pg_catalog.array_agg(a.attname::text ORDER BY a.attnum)
          INTO names
          FROM pg_catalog.pg_attribute AS a
         WHERE a.attrelid = '@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_scope'::pg_catalog.regclass
           AND a.attnum > 0 AND NOT a.attisdropped;
        IF names <> ARRAY['source_fingerprint','content_recipe_fingerprint','calculation_recipe_fingerprint',
                           'geometry_epoch','occurrence_context_fingerprint','principal_fingerprint',
                           'session_fingerprint','discourse_id','world_id','time_fingerprint','turn_ordinal',
                           'turn_flags','source_ordinal_base','preferred_batch_bytes']::text[] THEN
            RAISE EXCEPTION 'incompatible cognition_prompt_scope composite on 1.0.1 cluster';
        END IF;
    END IF;

    IF pg_catalog.to_regtype('@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admission_result') IS NULL THEN
        EXECUTE $ddl$
            CREATE TYPE @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admission_result AS (
                trunk_entity_id bytea,
                trunk_identity_witness bytea,
                trunk_physicality_id bytea,
                occurrence_id bytea,
                admission_receipt_id bytea,
                exact_bytes_fingerprint bytea,
                decomposition_trace_fingerprint bytea,
                atom_provider_fingerprint bytea,
                atom_provider_receipt_id bytea,
                presence_receipt_id bytea,
                persistence_receipt_id bytea,
                persisted_entity_count numeric(20,0),
                persisted_physicality_count numeric(20,0),
                persisted_trajectory_segment_count numeric(20,0),
                persisted_logical_occurrence_count numeric(20,0),
                publication_required boolean,
                status integer,
                version integer)
        $ddl$;
    ELSE
        SELECT pg_catalog.array_agg(a.attname::text ORDER BY a.attnum)
          INTO names
          FROM pg_catalog.pg_attribute AS a
         WHERE a.attrelid = '@LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admission_result'::pg_catalog.regclass
           AND a.attnum > 0 AND NOT a.attisdropped;
        IF names <> ARRAY['trunk_entity_id','trunk_identity_witness','trunk_physicality_id','occurrence_id',
                           'admission_receipt_id','exact_bytes_fingerprint','decomposition_trace_fingerprint',
                           'atom_provider_fingerprint','atom_provider_receipt_id','presence_receipt_id',
                           'persistence_receipt_id','persisted_entity_count','persisted_physicality_count',
                           'persisted_trajectory_segment_count','persisted_logical_occurrence_count',
                           'publication_required','status','version']::text[] THEN
            RAISE EXCEPTION 'incompatible cognition_prompt_admission_result composite on 1.0.1 cluster';
        END IF;
    END IF;
END
$laplace_persisted_types$;

CREATE OR REPLACE FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_execute_persisted(
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.execution_context,
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_request)
RETURNS @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_persisted_result
AS 'MODULE_PATHNAME', 'laplace_pg_cognition_observation_execute_persisted'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;
REVOKE EXECUTE ON FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_execute_persisted(
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.execution_context,
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_observation_request) FROM PUBLIC;

CREATE OR REPLACE FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admit(
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.execution_context,
    text,
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_scope)
RETURNS @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admission_result
AS 'MODULE_PATHNAME', 'laplace_pg_cognition_prompt_admit'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;
REVOKE EXECUTE ON FUNCTION @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_admit(
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.execution_context,
    text,
    @LAPLACE_OBSERVATION_COGNITION_SCHEMA@.cognition_prompt_scope) FROM PUBLIC;
