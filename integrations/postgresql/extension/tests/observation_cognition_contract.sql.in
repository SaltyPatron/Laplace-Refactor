-- Exercise both fresh schema and the genuine installed-extension update route.
CREATE EXTENSION laplace VERSION '1.0.0';
ALTER EXTENSION laplace UPDATE TO '1.0.1';
DO $upgrade$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_extension WHERE extname='laplace' AND extversion='1.0.1') THEN
        RAISE EXCEPTION 'installed extension version did not advance';
    END IF;
END $upgrade$;

CREATE FUNCTION pg_temp.execution_context()
RETURNS laplace.execution_context
LANGUAGE SQL IMMUTABLE PARALLEL SAFE
AS $context$
    SELECT ROW(
        ARRAY[
            decode(repeat('01',32),'hex'), decode(repeat('02',32),'hex'),
            decode(repeat('03',32),'hex'), decode(repeat('04',32),'hex'),
            decode(repeat('05',32),'hex'), decode(repeat('06',32),'hex'),
            decode(repeat('07',32),'hex'), decode(repeat('08',32),'hex'),
            decode(repeat('09',32),'hex'), decode(repeat('0a',32),'hex')
        ],
        decode(repeat('a0',32),'hex'), 16777216::bigint, 4, 1,
        1023::bigint, @LAPLACE_FRAMEWORK_MAJOR@::smallint,
        @LAPLACE_FRAMEWORK_MINOR@::smallint,
        @LAPLACE_FRAMEWORK_CONTEXT_READ_ONLY@::integer
    )::laplace.execution_context
$context$;

CREATE TEMP TABLE observation_cognition_fixture AS
SELECT
    ARRAY[
        ROW(
            decode(:'physicality_id','hex'),
            decode(:'entity_root','hex'),
            1, 1, 1, 1, 4, 0,
            decode(:'recipe_fingerprint','hex'),
            decode(:'geometry_epoch','hex'),
            decode(:'trajectory_fingerprint','hex'),
            0.125::double precision,
            -0.25::double precision,
            0.5::double precision,
            -0.75::double precision,
            0.875::double precision,
            3::numeric,
            3::numeric
        )::laplace.physicality_record
    ] AS physicalities,
    ARRAY[
        ROW(
            decode(:'physicality_id','hex'), 0::numeric,
            decode(:'carrier_0','hex'), decode(:'entity_a','hex'),
            :'logical_ordinal_0'::numeric, :'metadata_0'::bigint,
            :'atom_0'::bigint, :'packed_ordinal_0'::integer,
            :'run_length_0'::integer, :'tier_0'::smallint, true
        )::laplace.physicality_trajectory_segment_record,
        ROW(
            decode(:'physicality_id','hex'), 1::numeric,
            decode(:'carrier_1','hex'), decode(:'entity_b','hex'),
            :'logical_ordinal_1'::numeric, :'metadata_1'::bigint,
            :'atom_1'::bigint, :'packed_ordinal_1'::integer,
            :'run_length_1'::integer, :'tier_1'::smallint, true
        )::laplace.physicality_trajectory_segment_record,
        ROW(
            decode(:'physicality_id','hex'), 2::numeric,
            decode(:'carrier_2','hex'), decode(:'entity_c','hex'),
            :'logical_ordinal_2'::numeric, :'metadata_2'::bigint,
            :'atom_2'::bigint, :'packed_ordinal_2'::integer,
            :'run_length_2'::integer, :'tier_2'::smallint, true
        )::laplace.physicality_trajectory_segment_record
    ] AS segments,
    ROW(
        decode(:'entity_c','hex'),
        decode(:'entity_a','hex'),
        decode(:'world_id','hex'),
        decode(:'time_fingerprint','hex'),
        decode(:'context_fingerprint','hex'),
        decode(:'boundary','hex'),
        decode(:'evidence_epoch','hex'),
        decode(:'authority_id','hex'),
        decode(:'result_contract_fingerprint','hex'),
        ROW(
            2::numeric, 8::numeric, 8::numeric, 8::numeric,
            1048576::numeric, 8::numeric, 8::numeric, 2::numeric,
            2, 1, 2, 8
        )::laplace.cognition_observation_search_budget,
        ROW(
            2::numeric, 4::numeric, 4::numeric, 4::numeric,
            2::numeric, 128::numeric, 8::numeric, 8::numeric,
            4, 2
        )::laplace.cognition_observation_forward_limits,
        4, 1, 9, 1
    )::laplace.cognition_observation_request AS request;

-- Deposit the same canonical fixture into the actual durable product tables.
-- The persisted cognition route below receives none of the fixture arrays.
INSERT INTO laplace.entity(entity_id, identity_witness)
VALUES
    (decode(:'entity_a','hex'), decode(:'entity_a_witness','hex')),
    (decode(:'entity_b','hex'), decode(:'entity_b_witness','hex')),
    (decode(:'entity_c','hex'), decode(:'entity_c_witness','hex')),
    (decode(:'entity_root','hex'), decode(:'entity_root_witness','hex'));

INSERT INTO laplace.physicality(
    physicality_id, entity_id, physicality_type, vertex_class,
    recipe_version, structural_form, dimension_count, flags,
    recipe_fingerprint, geometry_epoch, trajectory_fingerprint,
    centroid_x, centroid_y, centroid_z, centroid_m, radius,
    logical_count, vertex_count, trajectory)
VALUES (
    decode(:'physicality_id','hex'), decode(:'entity_root','hex'),
    1, 1, 1, 1, 4, 0,
    decode(:'recipe_fingerprint','hex'),
    decode(:'geometry_epoch','hex'),
    decode(:'trajectory_fingerprint','hex'),
    0.125::double precision,
    -0.25::double precision,
    0.5::double precision,
    -0.75::double precision,
    0.875::double precision,
    3::numeric,
    3::numeric,
    decode(:'carrier_0','hex') ||
    decode(:'carrier_1','hex') ||
    decode(:'carrier_2','hex'));

CREATE TEMP TABLE observation_cognition_expected AS
SELECT
    decode(:'request_fingerprint','hex') AS request_fingerprint,
    decode(:'index_fingerprint','hex') AS index_fingerprint,
    decode(:'result_fingerprint','hex') AS result_fingerprint,
    decode(:'resolution_receipt_id','hex') AS resolution_receipt_id,
    decode(:'forward_receipt_id','hex') AS forward_receipt_id,
    decode(:'forward_program_fingerprint','hex') AS forward_program_fingerprint,
    decode(:'initial_state_id','hex') AS initial_state_id,
    decode(:'final_state_id','hex') AS final_state_id,
    decode(:'layer_trace_fingerprint','hex') AS layer_trace_fingerprint,
    decode(:'output_fingerprint','hex') AS output_fingerprint,
    :'expected_layer_count'::numeric AS layer_count,
    :'expected_provider_call_count'::numeric AS provider_call_count,
    :'expected_projected_query_count'::numeric AS projected_query_count,
    :'expected_candidate_operation_count'::numeric AS candidate_operation_count,
    :'expected_resolution_count'::numeric AS resolution_count,
    :'expected_resource_cost'::numeric AS resource_cost,
    :'expected_io_operations'::numeric AS io_operations,
    :'expected_database_operations'::numeric AS database_operations,
    :'expected_remaining_required'::numeric AS final_remaining_required_count,
    :'expected_completion'::integer AS final_completion,
    :'expected_disposition'::integer AS disposition,
    :'expected_obligation_disposition'::integer AS obligation_disposition,
    :'expected_status'::integer AS status,
    :'expected_version'::integer AS version,
    :'expected_flags'::integer AS flags;

CREATE TEMP TABLE observation_cognition_actual AS
SELECT (laplace.cognition_observation_execute(
    pg_temp.execution_context(), physicalities, segments, request)).*
FROM observation_cognition_fixture;

CREATE TEMP TABLE observation_cognition_persisted_actual AS
SELECT (laplace.cognition_observation_execute_persisted(
    pg_temp.execution_context(), request)).*
FROM observation_cognition_fixture;

DO $contract$
DECLARE
    actual observation_cognition_actual%ROWTYPE;
    persisted observation_cognition_persisted_actual%ROWTYPE;
    expected observation_cognition_expected%ROWTYPE;
BEGIN
    SELECT * INTO STRICT actual FROM observation_cognition_actual;
    SELECT * INTO STRICT persisted FROM observation_cognition_persisted_actual;
    SELECT * INTO STRICT expected FROM observation_cognition_expected;

    IF actual.request_fingerprint <> expected.request_fingerprint OR
       actual.index_fingerprint <> expected.index_fingerprint OR
       actual.result_fingerprint <> expected.result_fingerprint OR
       actual.resolution_receipt_id <> expected.resolution_receipt_id OR
       actual.forward_receipt_id <> expected.forward_receipt_id OR
       actual.forward_program_fingerprint <> expected.forward_program_fingerprint OR
       actual.initial_state_id <> expected.initial_state_id OR
       actual.final_state_id <> expected.final_state_id OR
       actual.layer_trace_fingerprint <> expected.layer_trace_fingerprint OR
       actual.output_fingerprint <> expected.output_fingerprint THEN
        RAISE EXCEPTION 'PostgreSQL observation cognition receipts diverged from the native oracle';
    END IF;

    IF actual.physicality_count <> 1 OR
       actual.trajectory_segment_count <> 3 OR
       actual.occurrence_run_count <> 3 OR
       actual.logical_occurrence_count <> 3 OR
       actual.indexed_entity_count <> 4 THEN
        RAISE EXCEPTION 'PostgreSQL observation cognition indexed-estate counters are wrong: %', actual;
    END IF;

    IF actual.layer_count <> expected.layer_count OR
       actual.provider_call_count <> expected.provider_call_count OR
       actual.projected_query_count <> expected.projected_query_count OR
       actual.candidate_operation_count <> expected.candidate_operation_count OR
       actual.resolution_count <> expected.resolution_count OR
       actual.resource_cost <> expected.resource_cost OR
       actual.io_operations <> expected.io_operations OR
       actual.database_operations <> expected.database_operations OR
       actual.final_remaining_required_count <> expected.final_remaining_required_count OR
       actual.final_completion <> expected.final_completion OR
       actual.disposition <> expected.disposition OR
       actual.obligation_disposition <> expected.obligation_disposition OR
       actual.status <> expected.status OR
       actual.version <> expected.version OR
       actual.flags <> expected.flags THEN
        RAISE EXCEPTION 'PostgreSQL observation cognition execution counters diverged from the native oracle: %', actual;
    END IF;

    IF actual.final_remaining_required_count <> 0 OR actual.resolution_count <> 1 THEN
        RAISE EXCEPTION 'PostgreSQL observation cognition did not resolve the required C -> A depth-2 predecessor request: %', actual;
    END IF;

    IF (persisted.execution).request_fingerprint IS DISTINCT FROM actual.request_fingerprint
       OR (persisted.execution).final_remaining_required_count <> 0
       OR (persisted.execution).resolution_count <> 1
       OR cardinality(persisted.answers) <> 1
       OR (persisted.answers[1]).entity_id IS DISTINCT FROM
             (SELECT (request).goal_entity_id FROM observation_cognition_fixture)
       OR (persisted.answers[1]).transition_count <> 2
       OR (persisted.answers[1]).independent_evidence_root_count <> 0
       OR (persisted.answers[1]).source_layer <> 1
       OR (persisted.answers[1]).direction <> 2
       OR octet_length((persisted.answers[1]).path_id) <> 32
       OR persisted.provider_rows_fetched <> 2
       OR persisted.provider_trajectory_bytes <> 192
       OR persisted.provider_batch_count <> 2
       OR (persisted.execution).database_operations <> 4 THEN
        RAISE EXCEPTION 'indexed persisted route did not execute exact C -> B -> A: %', persisted;
    END IF;
END
$contract$;

-- Independent native-built records outside this frontier must not increase its
-- fetched estate, affect its answer/receipts, or consume its workspace grant.
\i :unrelated_estate
CREATE TEMP TABLE observation_cognition_large_actual AS
SELECT (laplace.cognition_observation_execute_persisted(
    pg_temp.execution_context(), request)).* FROM observation_cognition_fixture;
DO $isolation$
DECLARE before record; after record; plan json; q laplace.cognition_observation_request;
BEGIN
    SELECT * INTO STRICT before FROM observation_cognition_persisted_actual;
    SELECT * INTO STRICT after FROM observation_cognition_large_actual;
    IF to_jsonb(before) IS DISTINCT FROM to_jsonb(after) THEN
        RAISE EXCEPTION 'unrelated estate changed request-relative execution: % / %', before, after;
    END IF;
    SELECT (request).* INTO STRICT q FROM observation_cognition_fixture;
    IF octet_length(q.anchor_entity_id) <> 16 THEN
        RAISE EXCEPTION 'index-plan probe lost the exact request binding';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_class WHERE oid='laplace.physicality_constituent_lookup_idx'::regclass
                   AND 'fastupdate=off'=ANY(reloptions)) THEN
        RAISE EXCEPTION 'interactive membership lookup can still scan deferred index writes';
    END IF;
    -- Use the same batched relation-mask predicate as the real persistence provider,
    -- immediately after bulk admission, without ANALYZE, VACUUM or planner hints.
    EXECUTE 'EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) SELECT physicality_id FROM laplace.physicality p '
            'WHERE p.physicality_type=1 AND '
            '((($2 & 2)<>0 AND p.entity_id=ANY($1)) OR '
            '(($2 & 29)<>0 AND laplace.trajectory_entity_ids(p.trajectory) && $1)) '
            'ORDER BY p.physicality_id LIMIT $3'
       INTO plan USING ARRAY[q.anchor_entity_id], q.relation_mask, 16;
    IF position('physicality_constituent_lookup_idx' in plan::text)=0 THEN
        RAISE EXCEPTION 'constituent membership did not use the maintained GIN index: %', plan;
    END IF;
    RAISE NOTICE 'indexed query plan: %', plan;
END $isolation$;

DO $failures$
DECLARE q laplace.cognition_observation_request; changed laplace.cognition_observation_request;
        search_limits laplace.cognition_observation_search_budget;
        forward_limits laplace.cognition_observation_forward_limits;
        observed laplace.cognition_observation_persisted_result; bad boolean;
        small_context laplace.execution_context;
BEGIN
    SELECT (request).* INTO STRICT q FROM observation_cognition_fixture;
    changed := q;
    search_limits := q.search_budget;
    search_limits.max_memory_bytes := 16777216;
    changed.search_budget := search_limits;
    bad := false;
    BEGIN
        PERFORM laplace.cognition_observation_execute_persisted(pg_temp.execution_context(),changed);
        bad := true;
    EXCEPTION WHEN program_limit_exceeded THEN NULL;
    END;
    IF bad THEN RAISE EXCEPTION 'missing provider workspace was accepted'; END IF;
    -- Metadata/decoded records alone fit here, but candidate staging does not.
    -- That extra storage must be reserved before payload/index construction.
    small_context := pg_temp.execution_context();
    small_context.memory_bytes := (q.search_budget).max_memory_bytes + 6000;
    bad := false;
    BEGIN
        PERFORM laplace.cognition_observation_execute_persisted(small_context, q);
        bad := true;
    EXCEPTION WHEN program_limit_exceeded THEN NULL;
    END;
    IF bad THEN RAISE EXCEPTION 'candidate staging escaped the provider memory grant'; END IF;
    changed := q;
    forward_limits := q.forward_limits;
    forward_limits.max_database_operations := 1;
    changed.forward_limits := forward_limits;
    bad := false;
    BEGIN
        PERFORM laplace.cognition_observation_execute_persisted(pg_temp.execution_context(),changed);
        bad := true;
    EXCEPTION WHEN program_limit_exceeded THEN NULL;
    END;
    IF bad THEN RAISE EXCEPTION 'exhausted database budget was accepted'; END IF;
    changed := q;
    changed.relation_mask := 32;
    bad := false;
    BEGIN
        PERFORM laplace.cognition_observation_execute_persisted(pg_temp.execution_context(),changed);
        bad := true;
    EXCEPTION WHEN feature_not_supported THEN NULL;
    END;
    IF bad THEN RAISE EXCEPTION 'physicality was promoted to testimony'; END IF;

    -- Same relevant physicality id with corrupt payload must fail native witness
    -- verification, not turn an index hit into unverified cognition evidence.
    bad := false;
    BEGIN
        UPDATE laplace.physicality SET trajectory=set_byte(trajectory,0,get_byte(trajectory,0)#1)
          WHERE physicality_id=(SELECT (physicalities[1]).physicality_id FROM observation_cognition_fixture);
        PERFORM laplace.cognition_observation_execute_persisted(pg_temp.execution_context(),q);
        bad := true;
    EXCEPTION WHEN data_corrupted THEN NULL;
    END;
    IF bad THEN RAISE EXCEPTION 'corrupt matched trajectory was accepted'; END IF;
    -- PL/pgSQL exception subtransaction must restore the data and allow the exact
    -- request to execute again; native owners must not survive error unwinding.
    observed := laplace.cognition_observation_execute_persisted(pg_temp.execution_context(),q);
    IF cardinality(observed.answers) <> 1 OR (observed.answers[1]).entity_id <> q.goal_entity_id THEN
        RAISE EXCEPTION 'database error cleanup prevented subsequent exact execution';
    END IF;
END $failures$;

SELECT json_build_object('schema','laplace.indexed-persisted-cognition-proof/v1',
 'unrelated_physicalities',4096,'goal_entity',encode((answers[1]).entity_id,'hex'),
 'transition_count',(answers[1]).transition_count,
 'independent_evidence_roots',(answers[1]).independent_evidence_root_count,
 'provider_rows',provider_rows_fetched,'provider_batches',provider_batch_count,
 'database_operations',(execution).database_operations,
 'complete',(execution).final_remaining_required_count=0) FROM observation_cognition_large_actual;

-- The native firmware image is built by the independent native probe and kept
-- as bytes. Only the admission/realization alphabet is a test fixture; search
-- uses the same concrete PostgreSQL provider as the standalone route above.
CREATE FUNCTION pg_temp.firmware_indexed(
    laplace.execution_context, bytea, bytea, text, bytea, bytea, bigint)
RETURNS text AS 'laplace_pg', 'laplace_pg_test_firmware_indexed'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;
CREATE FUNCTION pg_temp.firmware_context(selected bytea)
RETURNS laplace.execution_context LANGUAGE plpgsql AS $context$
DECLARE c laplace.execution_context;
BEGIN
    c := pg_temp.execution_context();
    c.epochs[@LAPLACE_FRAMEWORK_EPOCH_FIRMWARE@ + 1] := selected;
    RETURN c;
END $context$;
CREATE TEMP TABLE firmware_stored_programs AS SELECT
    decode(:'firmware_image','hex') AS image, decode(:'firmware_id','hex') AS id,
    decode(:'firmware_resume_image','hex') AS resume_image,
    decode(:'firmware_resume_id','hex') AS resume_id;
CREATE TEMP TABLE firmware_first_result AS SELECT
    pg_temp.firmware_indexed(pg_temp.firmware_context(id),image,id,'C',''::bytea,''::bytea,1048576)::jsonb AS result
    FROM firmware_stored_programs;
DO $firmware$
DECLARE p firmware_stored_programs%ROWTYPE; first jsonb; again jsonb; resumed jsonb; missing jsonb;
BEGIN
    SELECT * INTO STRICT p FROM firmware_stored_programs;
    SELECT result INTO STRICT first FROM firmware_first_result;
    RAISE NOTICE 'actual stored-provider firmware result: %',first;
    IF first->>'status' <> '0' OR first->>'output_hex' <> '41' OR
       (first->>'database_operations')::integer <= 0 OR
       (first->>'rows_fetched')::integer <= 0 THEN
        RAISE EXCEPTION 'firmware did not execute persisted predecessor evidence: %',first;
    END IF;
    again := pg_temp.firmware_indexed(pg_temp.firmware_context(p.id),p.image,p.id,
        'C',''::bytea,''::bytea,1048576)::jsonb;
    IF again <> first THEN RAISE EXCEPTION 'persistent firmware replay is not exact'; END IF;
    resumed := pg_temp.firmware_indexed(pg_temp.firmware_context(p.resume_id),p.resume_image,p.resume_id,
        'C',decode(first->>'checkpoint_hex','hex'),decode(first->>'checkpoint_id','hex'),1048576)::jsonb;
    IF resumed->>'status' <> '0' OR resumed->>'output_hex' <> '41' OR
       resumed->>'completed_steps' <> '3' OR resumed->>'checkpoint_id'=first->>'checkpoint_id' THEN
        RAISE EXCEPTION 'firmware did not restore and use retained result registers: %',resumed;
    END IF;
    missing := pg_temp.firmware_indexed(pg_temp.firmware_context(p.id),p.image,p.id,
        'C',''::bytea,''::bytea,16777216)::jsonb;
    IF missing->>'status'<>'13' OR missing->>'database_operations'<>'0' OR missing->>'output_hex'<>'' THEN
        RAISE EXCEPTION 'firmware exceeded its whole-request provider memory grant: %',missing;
    END IF;
    BEGIN
        DELETE FROM laplace.physicality WHERE physicality_id=
            (SELECT (physicalities[1]).physicality_id FROM observation_cognition_fixture);
        missing := pg_temp.firmware_indexed(pg_temp.firmware_context(p.id),p.image,p.id,
            'C',''::bytea,''::bytea,1048576)::jsonb;
        IF missing->>'status'='0' OR missing->>'output_hex'<>'' THEN
            RAISE EXCEPTION 'firmware supplied a completed answer without stored data: %',missing;
        END IF;
        RAISE SQLSTATE 'ZFW01' USING MESSAGE='rollback deliberate missing-data control';
    EXCEPTION WHEN SQLSTATE 'ZFW01' THEN NULL;
    END;
    BEGIN
        UPDATE laplace.physicality SET trajectory=set_byte(trajectory,0,get_byte(trajectory,0)#1)
          WHERE physicality_id=(SELECT (physicalities[1]).physicality_id FROM observation_cognition_fixture);
        PERFORM pg_temp.firmware_indexed(pg_temp.firmware_context(p.id),p.image,p.id,
            'C',''::bytea,''::bytea,1048576);
        RAISE EXCEPTION 'firmware accepted a corrupt stored trajectory';
    EXCEPTION WHEN data_corrupted THEN NULL;
    END;
    again := pg_temp.firmware_indexed(pg_temp.firmware_context(p.id),p.image,p.id,
        'C',''::bytea,''::bytea,1048576)::jsonb;
    IF again<>first THEN RAISE EXCEPTION 'PostgreSQL error unwinding changed subsequent firmware execution'; END IF;
    RAISE NOTICE 'firmware concrete-provider checks passed: result=%, steps=%, batches=%, database_operations=%; restored_steps=%',
        first->>'output_hex',first->>'completed_steps',first->>'batch_count',first->>'database_operations',resumed->>'completed_steps';
END $firmware$;
