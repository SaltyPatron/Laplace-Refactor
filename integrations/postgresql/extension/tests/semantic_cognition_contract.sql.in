CREATE EXTENSION laplace;

CREATE FUNCTION pg_temp.execution_context()
RETURNS laplace.execution_context
LANGUAGE SQL IMMUTABLE PARALLEL SAFE
AS $context$
    SELECT ROW(
        ARRAY[
            decode(repeat('01',32),'hex'), decode(repeat('02',32),'hex'),
            decode(repeat('03',32),'hex'), decode(repeat('04',32),'hex'),
            decode(repeat('05',32),'hex'), decode(repeat('06',32),'hex'),
            decode(repeat('07',32),'hex'), decode(repeat('08',32),'hex'),
            decode(repeat('09',32),'hex'), decode(repeat('0a',32),'hex')
        ],
        decode(repeat('a0',32),'hex'), 1048576::bigint, 4, 1,
        1023::bigint, @LAPLACE_FRAMEWORK_MAJOR@::smallint,
        @LAPLACE_FRAMEWORK_MINOR@::smallint,
        @LAPLACE_FRAMEWORK_CONTEXT_READ_ONLY@::integer
    )::laplace.execution_context
$context$;

CREATE FUNCTION pg_temp.explain_json(statement text)
RETURNS json
LANGUAGE plpgsql
AS $explain$
DECLARE
    plan json;
BEGIN
    EXECUTE 'EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) ' || statement INTO STRICT plan;
    RETURN plan;
END
$explain$;

-- This fixture targets the live durable provider boundary. The relation crossing
-- is backed by a real testimonial evidence root: the provider must bind the exact
-- mapping occurrence and preserve that root through native search. A bare mapping
-- row is deliberately insufficient to claim a TESTIMONY source layer.
SET session_replication_role = replica;
INSERT INTO laplace.reference_mapping_proposition(
    proposition_id,left_coordinate,right_coordinate,relation_id,
    relation_kind,relation_version,flags)
VALUES(
    decode(repeat('31',32),'hex'),
    decode(repeat('41',16),'hex'),
    decode(repeat('42',16),'hex'),
    decode(repeat('51',16),'hex'),
    1,1::numeric,1);
INSERT INTO laplace.reference_mapping_occurrence(
    mapping_id,occurrence_id,proposition_id,boundary_id,source_profile_id,
    left_reference_id,right_reference_id,row_entity_id,
    left_field_entity_id,left_value_entity_id,right_field_entity_id,right_value_entity_id,
    source_ordinal,artifact_ordinal,row_ordinal,left_disposition,right_disposition,disposition)
VALUES(
    decode(repeat('61',32),'hex'),
    decode(repeat('62',32),'hex'),
    decode(repeat('31',32),'hex'),
    decode(repeat('71',32),'hex'),
    decode(repeat('72',32),'hex'),
    decode(repeat('73',32),'hex'),
    decode(repeat('74',32),'hex'),
    decode(repeat('11',16),'hex'),
    decode(repeat('75',16),'hex'),
    decode(repeat('11',16),'hex'),
    decode(repeat('76',16),'hex'),
    decode(repeat('12',16),'hex'),
    1::numeric,1::numeric,1::numeric,1,1,1);

-- Representative cardinality negative control. These rows share the live boundary
-- and disposition but not the requested endpoints. An endpoint-unindexed provider
-- must therefore examine thousands of irrelevant mapping occurrences, while the
-- admitted physical plan should use the two boundary+endpoint partial indexes.
INSERT INTO laplace.reference_mapping_occurrence(
    mapping_id,occurrence_id,proposition_id,boundary_id,source_profile_id,
    left_reference_id,right_reference_id,row_entity_id,
    left_field_entity_id,left_value_entity_id,right_field_entity_id,right_value_entity_id,
    source_ordinal,artifact_ordinal,row_ordinal,left_disposition,right_disposition,disposition)
SELECT
    decode(md5('mapping-' || g::text) || md5('mapping-hi-' || g::text),'hex'),
    decode(md5('occurrence-' || g::text) || md5('occurrence-hi-' || g::text),'hex'),
    decode(repeat('31',32),'hex'),
    decode(repeat('71',32),'hex'),
    decode(repeat('72',32),'hex'),
    decode(md5('left-reference-' || g::text) || md5('left-reference-hi-' || g::text),'hex'),
    decode(md5('right-reference-' || g::text) || md5('right-reference-hi-' || g::text),'hex'),
    decode(md5('row-' || g::text),'hex'),
    decode(repeat('75',16),'hex'),
    decode(md5('left-value-' || g::text),'hex'),
    decode(repeat('76',16),'hex'),
    decode(md5('right-value-' || g::text),'hex'),
    (g + 10)::numeric,2::numeric,g::numeric,1,1,1
FROM generate_series(1,4096) AS generated(g);

INSERT INTO laplace.evidence_node(
    node_id,proposition_id,occurrence_id,source_id,context_id,
    source_ordinal,epistemic_kind,flags)
VALUES(
    decode(repeat('91',32),'hex'),
    decode(repeat('11',16),'hex'),
    decode(repeat('92',32),'hex'),
    decode(repeat('93',32),'hex'),
    decode(repeat('94',32),'hex'),
    1::numeric,2,0);
INSERT INTO laplace.evidence_root_projection(
    node_id,root_node_id,proposition_id,path_depth,root_epistemic_kind,flags)
VALUES(
    decode(repeat('91',32),'hex'),
    decode(repeat('91',32),'hex'),
    decode(repeat('11',16),'hex'),
    0::numeric,2,0);
INSERT INTO laplace.evidence_testimony(
    testimony_id,evidence_node_id,source_profile_id,recipe_receipt_id,
    trust_input_id,outcome_detail_id,uncertainty_numerator,
    uncertainty_denominator,sample_count,source_type,outcome_type,
    disposition,flags)
VALUES(
    decode(repeat('95',32),'hex'),
    decode(repeat('91',32),'hex'),
    decode(repeat('72',32),'hex'),
    decode(repeat('96',32),'hex'),
    decode(repeat('97',32),'hex'),
    decode(repeat('98',32),'hex'),
    0::numeric,1::numeric,1::numeric,1,1,1,0);

-- Close the exact semantic evidence into the same world-admission boundary that
-- owns the mapping. The provider must require both the node/root lineage members
-- and the exact testimony member; raw evidence rows outside this receipt closure
-- are not candidates for a boundary-pinned cognition program.
INSERT INTO laplace.world_admission(
    admission_id,source_profile_id,selected_boundary_fingerprint,
    source_profile_receipt_id,recipe_receipt_id,
    composition_working_set_receipt_id,composition_presence_receipt_id,
    composition_producer_receipt_id,composition_stream_receipt_id,
    evidence_lineage_receipt_id,evidence_testimony_receipt_id,
    readback_fingerprint,profile_occurrence_count,composition_occurrence_count,
    profile_claim_count,evidence_node_count,testimony_count,
    profile_bound_testimony_count,recipe_bound_testimony_count,
    lineage_bound_testimony_count,closure_subject_count,closed_subject_count,
    reconstruction_class,flags)
VALUES(
    decode(repeat('a1',32),'hex'),decode(repeat('72',32),'hex'),
    decode(repeat('71',32),'hex'),decode(repeat('a2',32),'hex'),
    decode(repeat('a3',32),'hex'),decode(repeat('a4',32),'hex'),
    decode(repeat('a5',32),'hex'),decode(repeat('a6',32),'hex'),
    decode(repeat('a7',32),'hex'),decode(repeat('aa',32),'hex'),
    decode(repeat('ab',32),'hex'),decode(repeat('ac',32),'hex'),
    1::numeric,1::numeric,1::numeric,1::numeric,1::numeric,
    1::numeric,1::numeric,1::numeric,1::numeric,1::numeric,1,0);
INSERT INTO laplace.evidence_lineage_receipt_member(
    receipt_id,node_id,member_ordinal)
VALUES(
    decode(repeat('aa',32),'hex'),decode(repeat('91',32),'hex'),1::numeric);
INSERT INTO laplace.evidence_testimony_receipt_member(
    receipt_id,testimony_id,member_ordinal)
VALUES(
    decode(repeat('ab',32),'hex'),decode(repeat('95',32),'hex'),1::numeric);
SET session_replication_role = origin;

ANALYZE laplace.reference_mapping_occurrence;

DO $endpoint_plan$
DECLARE
    left_plan json;
    right_plan json;
    either_plan json;
BEGIN
    left_plan := pg_temp.explain_json($sql$
        SELECT occurrence_id
        FROM laplace.reference_mapping_occurrence
        WHERE boundary_id = decode(repeat('71',32),'hex')
          AND disposition = 1
          AND left_value_entity_id = decode(repeat('11',16),'hex')
    $sql$);
    right_plan := pg_temp.explain_json($sql$
        SELECT occurrence_id
        FROM laplace.reference_mapping_occurrence
        WHERE boundary_id = decode(repeat('71',32),'hex')
          AND disposition = 1
          AND right_value_entity_id = decode(repeat('12',16),'hex')
    $sql$);
    either_plan := pg_temp.explain_json($sql$
        SELECT occurrence_id
        FROM laplace.reference_mapping_occurrence
        WHERE boundary_id = decode(repeat('71',32),'hex')
          AND disposition = 1
          AND (
              left_value_entity_id = decode(repeat('11',16),'hex') OR
              right_value_entity_id = decode(repeat('11',16),'hex'))
    $sql$);

    IF left_plan::text NOT LIKE '%reference_mapping_occurrence_left_semantic_idx%' THEN
        RAISE EXCEPTION 'left semantic endpoint did not select its boundary-scoped index: %', left_plan;
    END IF;
    IF right_plan::text NOT LIKE '%reference_mapping_occurrence_right_semantic_idx%' THEN
        RAISE EXCEPTION 'right semantic endpoint did not select its boundary-scoped index: %', right_plan;
    END IF;
    IF either_plan::text NOT LIKE '%reference_mapping_occurrence_left_semantic_idx%' OR
       either_plan::text NOT LIKE '%reference_mapping_occurrence_right_semantic_idx%' THEN
        RAISE EXCEPTION 'bidirectional semantic endpoint probe did not use both indexed branches: %', either_plan;
    END IF;
END
$endpoint_plan$;

CREATE TEMP TABLE semantic_cognition_fixture AS
SELECT ROW(
    decode(repeat('11',16),'hex'),
    decode(repeat('12',16),'hex'),
    decode(repeat('81',32),'hex'),
    decode(repeat('82',32),'hex'),
    decode(repeat('83',32),'hex'),
    decode(repeat('71',32),'hex'),
    decode(repeat('84',32),'hex'),
    decode(repeat('85',32),'hex'),
    decode(repeat('86',32),'hex'),
    ROW(
        4::numeric,8::numeric,8::numeric,8::numeric,
        1048576::numeric,8::numeric,8::numeric,4::numeric,
        2,1,4,8
    )::laplace.cognition_observation_search_budget,
    ROW(
        2::numeric,4::numeric,4::numeric,4::numeric,
        2::numeric,128::numeric,8::numeric,8::numeric,
        4,2
    )::laplace.cognition_observation_forward_limits,
    32,1,9,1
)::laplace.cognition_observation_request AS request;

CREATE TEMP TABLE semantic_cognition_actual AS
SELECT (laplace.cognition_semantic_execute(
    pg_temp.execution_context(), request)).*
FROM semantic_cognition_fixture;

DO $contract$
DECLARE
    actual semantic_cognition_actual%ROWTYPE;
BEGIN
    SELECT * INTO STRICT actual FROM semantic_cognition_actual;

    IF actual.answer_entity_id <> decode(repeat('12',16),'hex') THEN
        RAISE EXCEPTION 'live PostgreSQL semantic provider did not return the durable mapping target: %', actual;
    END IF;
    IF actual.relation_id <> decode(repeat('51',16),'hex') OR
       actual.relation_family <> 32 OR
       actual.source_layer <> 2 OR
       actual.direction <> 1 THEN
        RAISE EXCEPTION 'live PostgreSQL semantic provider erased typed relation identity or evidence plane: %', actual;
    END IF;
    IF actual.answer_count <> 1 OR actual.transition_count <> 1 OR
       actual.independent_evidence_root_count <> 1 OR
       actual.provider_rows_examined <> 1 OR
       actual.provider_database_operations < 1 OR
       actual.forward_database_operations < 1 OR
       actual.status <> 0 THEN
        RAISE EXCEPTION 'live PostgreSQL semantic cognition did not execute rooted durable evidence: %', actual;
    END IF;
    IF actual.provider_fingerprint IS NULL OR octet_length(actual.provider_fingerprint) <> 32 OR
       actual.request_fingerprint IS NULL OR octet_length(actual.request_fingerprint) <> 32 OR
       actual.path_id IS NULL OR octet_length(actual.path_id) <> 32 OR
       actual.forward_receipt_id IS NULL OR octet_length(actual.forward_receipt_id) <> 32 THEN
        RAISE EXCEPTION 'live PostgreSQL semantic cognition did not publish exact identities/receipts: %', actual;
    END IF;
END
$contract$;

-- A second independently selected mapping fits the same admitted row/evidence
-- closure. One candidate slot must observe the second row as an overflow
-- sentinel and publish no prefix; two slots must execute both selected rows.
SET session_replication_role = replica;
INSERT INTO laplace.reference_mapping_proposition(
    proposition_id,left_coordinate,right_coordinate,relation_id,
    relation_kind,relation_version,flags)
SELECT decode(repeat('32',32),'hex'),left_coordinate,
       decode(repeat('43',16),'hex'),relation_id,relation_kind,relation_version,flags
FROM laplace.reference_mapping_proposition
WHERE proposition_id = decode(repeat('31',32),'hex');
INSERT INTO laplace.reference_mapping_occurrence(
    mapping_id,occurrence_id,proposition_id,boundary_id,source_profile_id,
    left_reference_id,right_reference_id,row_entity_id,
    left_field_entity_id,left_value_entity_id,right_field_entity_id,right_value_entity_id,
    source_ordinal,artifact_ordinal,row_ordinal,left_disposition,right_disposition,disposition)
SELECT decode(repeat('63',32),'hex'),decode(repeat('64',32),'hex'),
       decode(repeat('32',32),'hex'),boundary_id,source_profile_id,
       left_reference_id,decode(repeat('77',32),'hex'),row_entity_id,
       left_field_entity_id,left_value_entity_id,right_field_entity_id,
       decode(repeat('13',16),'hex'),source_ordinal,artifact_ordinal,row_ordinal,
       left_disposition,right_disposition,disposition
FROM laplace.reference_mapping_occurrence
WHERE mapping_id = decode(repeat('61',32),'hex');
SET session_replication_role = origin;

DO $capacity_sentinel$
DECLARE
    fixture laplace.cognition_observation_request;
    budget laplace.cognition_observation_search_budget;
    actual semantic_cognition_actual%ROWTYPE;
    rejected boolean := false;
BEGIN
    SELECT (request).* INTO STRICT fixture FROM semantic_cognition_fixture;
    budget := fixture.search_budget;
    budget.transition_batch_capacity := 1;
    fixture.search_budget := budget;
    BEGIN
        PERFORM laplace.cognition_semantic_execute(
            pg_temp.execution_context(), fixture);
    EXCEPTION WHEN data_exception THEN
        IF SQLERRM <> 'Laplace live semantic cognition produced no readable terminal answer' THEN
            RAISE;
        END IF;
        rejected := true;
    END;
    IF NOT rejected THEN
        RAISE EXCEPTION 'semantic candidate overflow published a partial answer';
    END IF;

    budget.transition_batch_capacity := 2;
    fixture.search_budget := budget;
    SELECT result.* INTO STRICT actual
    FROM laplace.cognition_semantic_execute(
        pg_temp.execution_context(), fixture) AS result;
    IF actual.status IS DISTINCT FROM 0 OR actual.answer_count IS DISTINCT FROM 1 OR
       actual.answer_entity_id IS DISTINCT FROM decode(repeat('12',16),'hex') OR
       actual.provider_rows_examined IS DISTINCT FROM 2 OR
       actual.provider_database_operations IS DISTINCT FROM 1 THEN
        RAISE EXCEPTION 'semantic sentinel retry did not execute both selected rows: %', actual;
    END IF;
END
$capacity_sentinel$;

DELETE FROM laplace.reference_mapping_occurrence
WHERE mapping_id = decode(repeat('63',32),'hex');
DELETE FROM laplace.reference_mapping_proposition
WHERE proposition_id = decode(repeat('32',32),'hex');

-- Mutation control: a raw testimony row is not enough. Remove it from the exact
-- admitted testimony receipt while leaving the mapping, node, root projection and
-- testimony rows themselves intact. A boundary-pinned query must reject it.
DELETE FROM laplace.evidence_testimony_receipt_member
WHERE receipt_id = decode(repeat('ab',32),'hex')
  AND testimony_id = decode(repeat('95',32),'hex');

DO $outside_admission$
DECLARE
    rejected boolean := false;
    fixture laplace.cognition_observation_request;
BEGIN
    SELECT request INTO STRICT fixture FROM semantic_cognition_fixture;
    BEGIN
        PERFORM laplace.cognition_semantic_execute(
            pg_temp.execution_context(), fixture);
    EXCEPTION WHEN OTHERS THEN
        rejected := true;
    END;
    IF NOT rejected THEN
        RAISE EXCEPTION 'semantic testimony outside the world-admission receipt was accepted';
    END IF;
END
$outside_admission$;

SET session_replication_role = replica;
INSERT INTO laplace.evidence_testimony_receipt_member(
    receipt_id,testimony_id,member_ordinal)
VALUES(
    decode(repeat('ab',32),'hex'),decode(repeat('95',32),'hex'),1::numeric);
SET session_replication_role = origin;

-- Mutation control: remove the only root projection while leaving the relation,
-- admitted node and testimony rows intact. The semantic execution must no longer
-- succeed. This prevents an unrooted relation from being labeled TESTIMONY.
DELETE FROM laplace.evidence_root_projection
WHERE node_id = decode(repeat('91',32),'hex')
  AND root_node_id = decode(repeat('91',32),'hex');

DO $missing_root$
DECLARE
    rejected boolean := false;
    fixture laplace.cognition_observation_request;
BEGIN
    SELECT request INTO STRICT fixture FROM semantic_cognition_fixture;
    BEGIN
        PERFORM laplace.cognition_semantic_execute(
            pg_temp.execution_context(), fixture);
    EXCEPTION WHEN OTHERS THEN
        rejected := true;
    END;
    IF NOT rejected THEN
        RAISE EXCEPTION 'unrooted semantic testimony was accepted as cognition evidence';
    END IF;
END
$missing_root$;
