-- Mirror the native source-profile RAW observation denominator exception.
-- The legacy positive record/field law remains the ordinary case. No evidence
-- rows or substitute records/fields are created to satisfy these constraints.
DO $source_observation_profile_owner$
DECLARE guard_name text; expression text; expected_expression text;
BEGIN
    IF NOT EXISTS (
        SELECT FROM pg_catalog.pg_extension e
        JOIN pg_catalog.pg_class c ON c.oid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile'::regclass
        JOIN pg_catalog.pg_depend d ON d.classid='pg_catalog.pg_class'::regclass
          AND d.objid=c.oid AND d.refclassid='pg_catalog.pg_extension'::regclass
          AND d.refobjid=e.oid AND d.deptype='e'
        WHERE e.extname='laplace' AND e.extowner=c.relowner
          AND e.extowner=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
    ) THEN
        RAISE EXCEPTION 'source observation reconciliation requires the extension-owned profile table';
    END IF;
    FOREACH guard_name IN ARRAY ARRAY['record_count','field_count'] LOOP
        SELECT regexp_replace(pg_catalog.pg_get_expr(c.conbin,c.conrelid),
            '\s|[()]|::numeric', '', 'g') INTO expression
        FROM pg_catalog.pg_constraint c
        WHERE c.conrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile'::regclass
          AND c.conname='source_profile_' || guard_name || '_check'
          AND c.contype='c' AND c.convalidated;
        IF expression IS NULL OR expression NOT IN (guard_name || '>0',guard_name || '>=0') THEN
            RAISE EXCEPTION 'source observation reconciliation found an unrecognized count guard';
        END IF;
    END LOOP;
    -- Let PostgreSQL parse the expected expression using the actual column
    -- types. Compare its own canonical form, including numeric casts, before
    -- replacing an existing same-name coverage guard. This adds no data rows.
    ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile
        ADD CONSTRAINT source_profile_record_field_coverage_expected CHECK (
            (record_count > 0 AND field_count > 0 AND (not_applicable_mask::bigint & 48)=0)
            OR
            (record_count=0 AND field_count=0 AND claim_count=0
             AND (flags & 15)=2 AND (not_applicable_mask::bigint & 48)=48));
    SELECT pg_catalog.pg_get_expr(conbin,conrelid) INTO STRICT expected_expression
    FROM pg_catalog.pg_constraint
    WHERE conrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile'::regclass
      AND conname='source_profile_record_field_coverage_expected';
    IF EXISTS(SELECT FROM pg_catalog.pg_constraint
        WHERE conrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile'::regclass
          AND conname='source_profile_record_field_coverage' AND
          (contype<>'c' OR NOT convalidated OR
           pg_catalog.pg_get_expr(conbin,conrelid) IS DISTINCT FROM expected_expression)) THEN
        RAISE EXCEPTION 'source observation reconciliation found an unrecognized coverage guard';
    END IF;
END
$source_observation_profile_owner$;

ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile
    DROP CONSTRAINT IF EXISTS source_profile_record_count_check,
    ADD CONSTRAINT source_profile_record_count_check CHECK (record_count >= 0),
    DROP CONSTRAINT IF EXISTS source_profile_field_count_check,
    ADD CONSTRAINT source_profile_field_count_check CHECK (field_count >= 0),
    DROP CONSTRAINT IF EXISTS source_profile_record_field_coverage;
ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile
    RENAME CONSTRAINT source_profile_record_field_coverage_expected
    TO source_profile_record_field_coverage;
