-- Generated from this contract-owned declaration for fresh installs and the
-- existing product reconciliation owner. No evidence receipt rows are invented.
DO $world_observation_owner$
BEGIN
    IF NOT EXISTS (
        SELECT FROM pg_catalog.pg_extension e
        JOIN pg_catalog.pg_class c ON c.oid='@LAPLACE_PG_SCHEMA@.world_admission'::regclass
        JOIN pg_catalog.pg_depend d ON d.classid='pg_catalog.pg_class'::regclass
          AND d.objid=c.oid AND d.refclassid='pg_catalog.pg_extension'::regclass
          AND d.refobjid=e.oid AND d.deptype='e'
        WHERE e.extname='laplace' AND e.extowner=c.relowner
          AND e.extowner=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
    ) THEN
        RAISE EXCEPTION 'world observation reconciliation requires the extension-owned admission table';
    END IF;
END
$world_observation_owner$;

ALTER TABLE @LAPLACE_PG_SCHEMA@.world_admission
    ALTER COLUMN evidence_lineage_receipt_id DROP NOT NULL,
    ALTER COLUMN evidence_testimony_receipt_id DROP NOT NULL,
    DROP CONSTRAINT IF EXISTS world_admission_evidence_coverage,
    ADD CONSTRAINT world_admission_evidence_coverage CHECK (
        (profile_claim_count=0
         AND evidence_lineage_receipt_id IS NULL
         AND evidence_testimony_receipt_id IS NULL
         AND evidence_node_count=0 AND testimony_count=0
         AND profile_bound_testimony_count=0
         AND recipe_bound_testimony_count=0
         AND lineage_bound_testimony_count=0)
        OR
        (profile_claim_count>0
         AND evidence_lineage_receipt_id IS NOT NULL
         AND evidence_testimony_receipt_id IS NOT NULL
         AND evidence_node_count>0 AND testimony_count>0));
