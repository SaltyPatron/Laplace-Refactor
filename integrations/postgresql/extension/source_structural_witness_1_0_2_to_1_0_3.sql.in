-- Retain historical syntax metadata as NULL: zero is a valid coordinate,
-- not evidence that an older writer captured a field. Exact native replay may
-- fill the missing coordinates only after matching every original witness field.
ALTER TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness
    ADD COLUMN grammar_kind numeric(20, 0)
        CHECK (grammar_kind BETWEEN 0 AND 18446744073709551615),
    ADD COLUMN field_kind numeric(20, 0)
        CHECK (field_kind BETWEEN 0 AND 18446744073709551615),
    ADD COLUMN sibling_ordinal numeric(20, 0)
        CHECK (sibling_ordinal BETWEEN 0 AND 18446744073709551615),
    ADD COLUMN syntax_flags numeric(20, 0)
        CHECK (syntax_flags BETWEEN 0 AND 4294967295);

ALTER TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness
    ADD CONSTRAINT source_structural_witness_syntax_presence CHECK (
        (grammar_kind IS NULL AND field_kind IS NULL AND sibling_ordinal IS NULL AND syntax_flags IS NULL)
        OR
        (grammar_kind IS NOT NULL AND field_kind IS NOT NULL AND sibling_ordinal IS NOT NULL AND syntax_flags IS NOT NULL));

-- Preserve v1 receipts verbatim. The richer hash preimage uses v2 and can
-- coexist with its predecessor for the same composition execution.
ALTER TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness_receipt
    DROP CONSTRAINT source_structural_witness_receipt_version_check,
    ADD CONSTRAINT source_structural_witness_receipt_version_check
        CHECK (version IN (1, 2)),
    DROP CONSTRAINT source_structural_witness_rec_source_profile_id_composition_key,
    ADD CONSTRAINT source_structural_witness_receipt_profile_execution_version_key
        UNIQUE (source_profile_id, composition_working_set_receipt, version);

DO $laplace_source_structural_witness_103$
DECLARE
    missing integer;
BEGIN
    SELECT count(*) INTO missing
      FROM (VALUES ('grammar_kind'),('field_kind'),('sibling_ordinal'),('syntax_flags')) AS expected(name)
     WHERE NOT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_attribute a
          JOIN pg_catalog.pg_class c ON c.oid=a.attrelid
          JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace
         WHERE n.nspname='@LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@'
           AND c.relname='source_structural_witness'
           AND a.attname=expected.name
           AND a.attnum>0
           AND NOT a.attisdropped
           AND NOT a.attnotnull
     );
    IF missing <> 0 THEN
        RAISE EXCEPTION 'Laplace 1.0.3 structural witness migration is incomplete: % columns missing', missing;
    END IF;
END
$laplace_source_structural_witness_103$;
