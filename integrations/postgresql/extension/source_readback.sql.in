-- The same owned declaration serves fresh installs and repeated product reconciliation.
-- Readback observes canonical source content; it does not admit semantic evidence.
DO $source_readback_type$
DECLARE owner_oid oid; type_oid oid; relation_oid oid; names text[]; types text[];
BEGIN
    SELECT extowner INTO STRICT owner_oid FROM pg_catalog.pg_extension WHERE extname='laplace';
    IF pg_catalog.pg_get_userbyid(owner_oid)<>current_user OR NOT EXISTS (
        SELECT FROM pg_catalog.pg_namespace WHERE nspname='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@' AND nspowner=owner_oid)
    THEN RAISE EXCEPTION 'source readback reconciliation requires the extension and schema owner'; END IF;
    type_oid:=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result');
    IF type_oid IS NULL THEN
        EXECUTE $ddl$CREATE TYPE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result AS (
    content bytea,
    root_content_id bytea,
    artifact_index numeric,
    source_profile_id bytea,
    structural_receipt_id bytea,
    source_binding_id bytea,
    recipe_id bytea,
    materialization_receipt_id bytea,
    provider_fingerprint bytea,
    readset_fingerprint bytea,
    output_fingerprint bytea,
    output_bytes numeric,
    resolved_nodes numeric,
    trajectory_carriers numeric,
    codepoint_count numeric,
    maximum_depth integer,
    verified_witnesses numeric,
    database_operations numeric,
    version integer
);$ddl$;
        type_oid:=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result');
    END IF;
    SELECT typrelid INTO relation_oid FROM pg_catalog.pg_type
    WHERE oid=type_oid AND typowner=owner_oid AND typtype='c'
      AND typnamespace=pg_catalog.to_regnamespace('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@');
    IF relation_oid IS NULL OR relation_oid=0 THEN RAISE EXCEPTION 'source readback result is not the owned composite'; END IF;
    SELECT array_agg(attname::text ORDER BY attnum),
        array_agg(pg_catalog.format_type(atttypid,atttypmod) ORDER BY attnum)
    INTO names,types FROM pg_catalog.pg_attribute WHERE attrelid=relation_oid AND attnum>0;
    IF names IS DISTINCT FROM ARRAY['content','root_content_id','artifact_index','source_profile_id','structural_receipt_id','source_binding_id','recipe_id','materialization_receipt_id','provider_fingerprint','readset_fingerprint','output_fingerprint','output_bytes','resolved_nodes','trajectory_carriers','codepoint_count','maximum_depth','verified_witnesses','database_operations','version']::text[] OR
        types IS DISTINCT FROM ARRAY['bytea','bytea','numeric','bytea','bytea','bytea','bytea','bytea','bytea','bytea','bytea','numeric','numeric','numeric','numeric','integer','numeric','numeric','integer']::text[]
    THEN RAISE EXCEPTION 'source readback result has an incompatible shape'; END IF;
END
$source_readback_type$;

DO $source_readback_collision$
DECLARE function_oid oid; owner_oid oid;
BEGIN
    SELECT extowner INTO STRICT owner_oid FROM pg_catalog.pg_extension WHERE extname='laplace';
    function_oid:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric)');
    IF function_oid IS NOT NULL AND NOT EXISTS (
        SELECT FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_language l ON l.oid=p.prolang
        WHERE p.oid=function_oid AND p.proowner=owner_oid AND l.lanname='c'
          AND p.probin='@LAPLACE_SOURCE_GRAMMAR_MODULE@' AND p.prosrc='laplace_pg_source_readback_utf8'
          AND p.prorettype=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result')
          AND p.provolatile='v' AND p.proisstrict AND p.proparallel='u'
          AND NOT p.prosecdef AND NOT p.proretset AND p.proconfig IS NULL)
    THEN RAISE EXCEPTION 'source readback function has an incompatible owner or implementation'; END IF;
END
$source_readback_collision$;

CREATE OR REPLACE FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8(
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,
    bytea, bytea, numeric,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,
    numeric)
RETURNS @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result
AS '@LAPLACE_SOURCE_GRAMMAR_MODULE@', 'laplace_pg_source_readback_utf8'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;
REVOKE ALL ON FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8(
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,
    bytea, bytea, numeric,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,
    numeric) FROM PUBLIC;

DO $source_readback_membership$
DECLARE extension_oid oid; object_oid oid;
BEGIN
    SELECT oid INTO STRICT extension_oid FROM pg_catalog.pg_extension WHERE extname='laplace';
    object_oid:=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result');
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_depend WHERE classid='pg_catalog.pg_type'::regclass
        AND objid=object_oid AND refclassid='pg_catalog.pg_extension'::regclass
        AND refobjid=extension_oid AND deptype='e') THEN
        ALTER EXTENSION laplace ADD TYPE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result;
    END IF;
    object_oid:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric)');
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_depend WHERE classid='pg_catalog.pg_proc'::regclass
        AND objid=object_oid AND refclassid='pg_catalog.pg_extension'::regclass
        AND refobjid=extension_oid AND deptype='e') THEN
        ALTER EXTENSION laplace ADD FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric);
    END IF;
END
$source_readback_membership$;

-- One statement snapshot; one complete structural receipt verification for the
-- selected sorted, unique artifact indexes. All result rows become available
-- only after every requested file validates. No cache crosses statement calls.
DO $source_readback_batch_collision$
DECLARE function_oid oid; owner_oid oid;
BEGIN
    SELECT extowner INTO STRICT owner_oid FROM pg_catalog.pg_extension WHERE extname='laplace';
    function_oid:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8_batch(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric,numeric)');
    IF function_oid IS NOT NULL AND NOT EXISTS (
        SELECT FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_language l ON l.oid=p.prolang
        WHERE p.oid=function_oid AND p.proowner=owner_oid AND l.lanname='c'
          AND p.probin='@LAPLACE_SOURCE_GRAMMAR_MODULE@' AND p.prosrc='laplace_pg_source_readback_utf8_batch'
          AND p.prorettype=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result')
          AND p.provolatile='v' AND p.proisstrict AND p.proparallel='u'
          AND NOT p.prosecdef AND p.proretset AND p.proconfig IS NULL)
    THEN RAISE EXCEPTION 'source batch readback function has an incompatible owner or implementation'; END IF;
END
$source_readback_batch_collision$;
CREATE OR REPLACE FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8_batch(
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context, bytea, bytea, numeric[],
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request, numeric, numeric)
RETURNS SETOF @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_result
AS '@LAPLACE_SOURCE_GRAMMAR_MODULE@', 'laplace_pg_source_readback_utf8_batch'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;
REVOKE ALL ON FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8_batch(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric,numeric) FROM PUBLIC;
DO $source_readback_batch_membership$
DECLARE extension_oid oid; object_oid oid;
BEGIN
    SELECT oid INTO STRICT extension_oid FROM pg_catalog.pg_extension WHERE extname='laplace';
    object_oid:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8_batch(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric,numeric)');
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_depend WHERE classid='pg_catalog.pg_proc'::regclass
        AND objid=object_oid AND refclassid='pg_catalog.pg_extension'::regclass
        AND refobjid=extension_oid AND deptype='e') THEN
        ALTER EXTENSION laplace ADD FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_readback_utf8_batch(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,bytea,bytea,numeric[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.cognition_materialization_request,numeric,numeric);
    END IF;
END
$source_readback_batch_membership$;
