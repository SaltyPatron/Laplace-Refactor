-- Canonical composition may calculate and durably receipt structure without
-- witnessing an occurrence.  occurrence_count is therefore a nonnegative
-- emitted-state count, while logical_occurrence_count remains the positive
-- denominator derived from the nonempty request set.
ALTER TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.composition_execution_receipt
    DROP CONSTRAINT composition_execution_receipt_occurrence_count_check;
ALTER TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.composition_execution_receipt
    ADD CONSTRAINT composition_execution_receipt_occurrence_count_check
    CHECK (occurrence_count >= 0);

CREATE TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness (
    source_profile_id @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL
        REFERENCES @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_profile(profile_id)
        DEFERRABLE INITIALLY DEFERRED,
    artifact_index numeric(20, 0) NOT NULL
        CHECK (artifact_index BETWEEN 0 AND 18446744073709551615),
    span_index numeric(20, 0) NOT NULL
        CHECK (span_index BETWEEN 0 AND 18446744073709551615),
    parent_span_index numeric(20, 0) NOT NULL
        CHECK (parent_span_index BETWEEN 0 AND 18446744073709551615),
    trace_fingerprint @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL,
    provider_fingerprint @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL,
    canonical_entity_id @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.content_id_128
        REFERENCES @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.entity(entity_id),
    byte_start numeric(20, 0) NOT NULL
        CHECK (byte_start BETWEEN 0 AND 18446744073709551615),
    byte_end numeric(20, 0) NOT NULL
        CHECK (byte_end BETWEEN 0 AND 18446744073709551615),
    kind numeric(20, 0) NOT NULL
        CHECK (kind BETWEEN 0 AND 18446744073709551615),
    grammar_kind numeric(20, 0)
        CHECK (grammar_kind BETWEEN 0 AND 18446744073709551615),
    field_kind numeric(20, 0)
        CHECK (field_kind BETWEEN 0 AND 18446744073709551615),
    sibling_ordinal numeric(20, 0)
        CHECK (sibling_ordinal BETWEEN 0 AND 18446744073709551615),
    media_type bytea NOT NULL,
    depth numeric(20, 0) NOT NULL CHECK (depth BETWEEN 0 AND 4294967295),
    flags numeric(20, 0) NOT NULL CHECK (flags BETWEEN 0 AND 4294967295),
    syntax_flags numeric(20, 0) CHECK (syntax_flags BETWEEN 0 AND 4294967295),
    CONSTRAINT source_structural_witness_syntax_presence CHECK (
        (grammar_kind IS NULL AND field_kind IS NULL AND sibling_ordinal IS NULL AND syntax_flags IS NULL)
        OR
        (grammar_kind IS NOT NULL AND field_kind IS NOT NULL AND sibling_ordinal IS NOT NULL AND syntax_flags IS NOT NULL)),
    CONSTRAINT source_structural_witness_content_presence CHECK (
        (byte_start < byte_end AND canonical_entity_id IS NOT NULL) OR
        (byte_start = byte_end AND canonical_entity_id IS NULL AND
         syntax_flags IS NOT NULL AND (syntax_flags::bigint & 34) <> 0)),
    CHECK (
        parent_span_index = 18446744073709551615 OR
        parent_span_index < span_index),
    PRIMARY KEY (source_profile_id, artifact_index, span_index)
);

CREATE INDEX source_structural_witness_entity_idx
    ON @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness
    (canonical_entity_id, source_profile_id, artifact_index, span_index);

CREATE TABLE @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness_receipt (
    receipt_id @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 PRIMARY KEY,
    source_profile_id @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL
        REFERENCES @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_profile(profile_id)
        DEFERRABLE INITIALLY DEFERRED,
    composition_working_set_receipt @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL
        REFERENCES @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.composition_execution_receipt(working_set_receipt),
    witness_fingerprint @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.record_id_256 NOT NULL,
    witness_count numeric(20, 0) NOT NULL CHECK (witness_count > 0),
    version integer NOT NULL CHECK (version IN (1, 2)),
    recorded_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    recorded_by name NOT NULL DEFAULT current_user,
    CONSTRAINT source_structural_witness_receipt_profile_execution_version_key
        UNIQUE (source_profile_id, composition_working_set_receipt, version)
);

REVOKE ALL ON @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness FROM PUBLIC;
REVOKE ALL ON @LAPLACE_SOURCE_STRUCTURAL_WITNESS_SCHEMA@.source_structural_witness_receipt FROM PUBLIC;
