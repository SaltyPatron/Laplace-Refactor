-- Preserve exact missing syntax observations without inventing empty content.
DO $source_witness_missing$
DECLARE existing record;
BEGIN
    IF NOT EXISTS (
        SELECT FROM pg_catalog.pg_extension e
        JOIN pg_catalog.pg_class c ON c.oid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness'::regclass
        JOIN pg_catalog.pg_depend d ON d.classid='pg_catalog.pg_class'::regclass
          AND d.objid=c.oid AND d.refclassid='pg_catalog.pg_extension'::regclass
          AND d.refobjid=e.oid AND d.deptype='e'
        WHERE e.extname='laplace' AND e.extowner=c.relowner
          AND e.extowner=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)
    ) THEN
        RAISE EXCEPTION 'source grammar reconciliation requires the extension-owned witness table';
    END IF;
    FOR existing IN SELECT conname FROM pg_catalog.pg_constraint
        WHERE conrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness'::regclass
          AND contype='c' AND conname<>'source_structural_witness_content_presence'
          AND pg_catalog.pg_get_constraintdef(oid)='CHECK ((byte_start < byte_end))'
    LOOP
        EXECUTE pg_catalog.format('ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness DROP CONSTRAINT %I', existing.conname);
    END LOOP;
END
$source_witness_missing$;
ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness
    ALTER COLUMN canonical_entity_id DROP NOT NULL,
    DROP CONSTRAINT IF EXISTS source_structural_witness_byte_end_check,
    ADD CONSTRAINT source_structural_witness_byte_end_check CHECK (byte_end BETWEEN 0 AND 18446744073709551615),
    DROP CONSTRAINT IF EXISTS source_structural_witness_content_presence,
    ADD CONSTRAINT source_structural_witness_content_presence CHECK (
        (byte_start < byte_end AND canonical_entity_id IS NOT NULL) OR
        (byte_start=byte_end AND canonical_entity_id IS NULL AND
         syntax_flags IS NOT NULL AND (syntax_flags::bigint & 34)<>0));

-- v3 binds the actual immutable physicality selected by native composition.
-- Preserve historical NULLs and v1/v2 receipts; only exact native replay may
-- enrich an existing witness. No epoch/recipe heuristic fills old bindings.
DO $source_witness_physicality$
DECLARE witness_table oid:='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness'::regclass;
 receipt_table oid:='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness_receipt'::regclass;
 selected_column smallint; target_column smallint; expression text;
BEGIN
 IF NOT EXISTS (
   SELECT FROM pg_catalog.pg_extension e JOIN pg_catalog.pg_class c ON c.oid=receipt_table
   JOIN pg_catalog.pg_depend d ON d.classid='pg_catalog.pg_class'::regclass AND d.objid=c.oid
    AND d.refclassid='pg_catalog.pg_extension'::regclass AND d.refobjid=e.oid AND d.deptype='e'
   WHERE e.extname='laplace' AND e.extowner=c.relowner
    AND e.extowner=(SELECT oid FROM pg_catalog.pg_roles WHERE rolname=current_user)) THEN
   RAISE EXCEPTION 'source physicality reconciliation requires the extension-owned receipt table';
 END IF;
 IF EXISTS(SELECT FROM pg_catalog.pg_attribute WHERE attrelid=witness_table
    AND attname='canonical_physicality_id' AND NOT attisdropped) THEN
   IF NOT EXISTS(SELECT FROM pg_catalog.pg_attribute WHERE attrelid=witness_table
      AND attname='canonical_physicality_id' AND attnum>0 AND NOT attisdropped
      AND atttypid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.record_id_256'::regtype
      AND NOT attnotnull AND NOT atthasdef) THEN
     RAISE EXCEPTION 'source physicality witness column has an incompatible type or presence law';
   END IF;
 ELSE
   ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness
     ADD COLUMN canonical_physicality_id @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.record_id_256;
 END IF;
 SELECT attnum INTO STRICT selected_column FROM pg_catalog.pg_attribute
  WHERE attrelid=witness_table AND attname='canonical_physicality_id' AND NOT attisdropped;
 SELECT attnum INTO STRICT target_column FROM pg_catalog.pg_attribute
  WHERE attrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.physicality'::regclass
   AND attname='physicality_id' AND NOT attisdropped;
 IF EXISTS(SELECT FROM pg_catalog.pg_constraint WHERE conrelid=witness_table
    AND conname='source_witness_physicality_fk') THEN
   IF NOT EXISTS(SELECT FROM pg_catalog.pg_constraint WHERE conrelid=witness_table
      AND conname='source_witness_physicality_fk' AND contype='f' AND convalidated
      AND conkey=ARRAY[selected_column] AND confkey=ARRAY[target_column]
      AND confrelid='@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.physicality'::regclass
      AND confupdtype='a' AND confdeltype='a' AND confmatchtype='s' AND NOT condeferrable) THEN
     RAISE EXCEPTION 'source physicality witness foreign key has an incompatible definition';
   END IF;
 ELSE
   ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness
    ADD CONSTRAINT source_witness_physicality_fk FOREIGN KEY(canonical_physicality_id)
      REFERENCES @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.physicality(physicality_id);
 END IF;
 IF EXISTS(SELECT FROM pg_catalog.pg_constraint WHERE conrelid=witness_table
    AND conname='source_witness_physicality_presence') THEN
   SELECT regexp_replace(lower(pg_catalog.pg_get_expr(conbin,conrelid)),'\s|[()]','','g')
    INTO expression FROM pg_catalog.pg_constraint WHERE conrelid=witness_table
     AND conname='source_witness_physicality_presence' AND contype='c' AND convalidated;
   IF expression IS DISTINCT FROM 'canonical_physicality_idisnullorcanonical_entity_idisnotnull' THEN
     RAISE EXCEPTION 'source physicality witness presence guard has an incompatible definition';
   END IF;
 ELSE
   ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness
    ADD CONSTRAINT source_witness_physicality_presence CHECK (
     canonical_physicality_id IS NULL OR canonical_entity_id IS NOT NULL);
 END IF;
 SELECT regexp_replace(lower(pg_catalog.pg_get_expr(conbin,conrelid)),'\s|[()]|::integer','','g')
  INTO expression FROM pg_catalog.pg_constraint WHERE conrelid=receipt_table
   AND conname='source_structural_witness_receipt_version_check' AND contype='c' AND convalidated;
 IF expression IS NULL OR expression NOT IN ('version=anyarray[1,2]','version=anyarray[1,2,3]','version=anyarray[1,2,3,4]') THEN
   RAISE EXCEPTION 'source physicality receipt version guard has an incompatible definition';
 END IF;
 -- Recurring reconciliation must preserve an already-admitted v4 schema.
 IF expression <> 'version=anyarray[1,2,3,4]' THEN
 ALTER TABLE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_structural_witness_receipt
  DROP CONSTRAINT source_structural_witness_receipt_version_check,
  ADD CONSTRAINT source_structural_witness_receipt_version_check CHECK(version IN (1,2,3));
 END IF;
END
$source_witness_physicality$;

-- One verified syntax-provider binding for the shared source-admission owner.
-- Selecting a native library remains an administrator operation. Provider build
-- receipts are exact provenance; parsing grants no semantic testimony.
DO $source_grammar_type$
DECLARE type_id oid; extension_owner oid; names text[]; types text[];
BEGIN
SELECT extowner INTO STRICT extension_owner FROM pg_catalog.pg_extension WHERE extname='laplace';
IF pg_catalog.pg_get_userbyid(extension_owner)<>current_user THEN
 RAISE EXCEPTION 'source grammar binding requires the Laplace extension owner';
END IF;
IF pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding') IS NULL THEN
CREATE TYPE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding AS (
    library_path text,
    language_symbol text,
    media_type text,
    kind_base numeric,
    declaration_fingerprint bytea,
    library_sha256 bytea,
    library_bytes bigint,
    maximum_depth integer
);
END IF;
type_id:=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding');
IF NOT EXISTS(SELECT FROM pg_catalog.pg_type t JOIN pg_catalog.pg_class c ON c.oid=t.typrelid
 WHERE t.oid=type_id AND t.typtype='c' AND t.typowner=extension_owner AND c.relnatts=8) THEN
 RAISE EXCEPTION 'source grammar binding has an incompatible owner or shape';
END IF;
SELECT array_agg(a.attname::text ORDER BY a.attnum),array_agg(pg_catalog.format_type(a.atttypid,a.atttypmod) ORDER BY a.attnum)
 INTO names,types FROM pg_catalog.pg_attribute a JOIN pg_catalog.pg_type t ON t.typrelid=a.attrelid
 WHERE t.oid=type_id AND a.attnum>0 AND NOT a.attisdropped;
IF names IS DISTINCT FROM ARRAY['library_path','language_symbol','media_type','kind_base','declaration_fingerprint','library_sha256','library_bytes','maximum_depth'] OR
 types IS DISTINCT FROM ARRAY['text','text','text','numeric','bytea','bytea','bigint','integer'] THEN
 RAISE EXCEPTION 'source grammar binding fields differ from the native ABI';
END IF;
IF NOT EXISTS(SELECT FROM pg_catalog.pg_depend d JOIN pg_catalog.pg_extension e ON e.oid=d.refobjid
 WHERE d.classid='pg_catalog.pg_type'::regclass AND d.objid=type_id AND d.deptype='e' AND e.extname='laplace') THEN
 ALTER EXTENSION laplace ADD TYPE @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding;
END IF;
END
$source_grammar_type$;

DO $source_grammar_collision$
DECLARE selected oid; owner_id oid;
BEGIN
 SELECT extowner INTO STRICT owner_id FROM pg_catalog.pg_extension WHERE extname='laplace';
 selected:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_admit_with_grammar(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile_manifest,bytea,bytea,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_artifact[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_reference_rule[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_mapping_rule[],numeric,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding)');
 IF selected IS NOT NULL AND NOT EXISTS(SELECT FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_language l ON l.oid=p.prolang
  WHERE p.oid=selected AND p.proowner=owner_id AND l.lanname='c'
    AND p.probin='@LAPLACE_SOURCE_GRAMMAR_MODULE@' AND p.prosrc='laplace_pg_source_admit_tabular'
    AND p.prorettype=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_admission_result')
    AND p.provolatile='v' AND p.proisstrict AND p.proparallel='u'
    AND NOT p.prosecdef AND NOT p.proretset AND p.proconfig IS NULL) THEN
  RAISE EXCEPTION 'source grammar function has an incompatible owner or implementation';
 END IF;
END
$source_grammar_collision$;

CREATE OR REPLACE FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_admit_with_grammar(
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile_manifest,
    bytea, bytea,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_artifact[],
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_reference_rule[],
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_mapping_rule[], numeric,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding)
RETURNS @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_admission_result
AS '@LAPLACE_SOURCE_GRAMMAR_MODULE@', 'laplace_pg_source_admit_tabular'
LANGUAGE C VOLATILE STRICT PARALLEL UNSAFE;

REVOKE ALL ON FUNCTION @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_admit_with_grammar(
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile_manifest,
    bytea, bytea,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_artifact[],
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_reference_rule[],
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_mapping_rule[], numeric,
    @LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding) FROM PUBLIC;

DO $source_grammar_function$
DECLARE selected oid; owner_id oid;
BEGIN
 SELECT extowner INTO STRICT owner_id FROM pg_catalog.pg_extension WHERE extname='laplace';
 selected:=pg_catalog.to_regprocedure('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_admit_with_grammar(@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.execution_context,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_profile_manifest,bytea,bytea,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_artifact[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_reference_rule[],@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_mapping_rule[],numeric,@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.source_grammar_binding)');
 IF NOT EXISTS(SELECT FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_language l ON l.oid=p.prolang
  WHERE p.oid=selected AND p.proowner=owner_id AND l.lanname='c'
    AND p.probin='@LAPLACE_SOURCE_GRAMMAR_MODULE@' AND p.prosrc='laplace_pg_source_admit_tabular'
    AND p.prorettype=pg_catalog.to_regtype('@LAPLACE_SOURCE_ADMISSION_METRICS_SCHEMA@.tabular_source_admission_result')
    AND p.provolatile='v' AND p.proisstrict AND p.proparallel='u'
    AND NOT p.prosecdef AND NOT p.proretset AND p.proconfig IS NULL) THEN
  RAISE EXCEPTION 'source grammar function differs from the owned native ABI';
 END IF;
 IF NOT EXISTS(SELECT FROM pg_catalog.pg_depend d JOIN pg_catalog.pg_extension e ON e.oid=d.refobjid
  WHERE d.classid='pg_catalog.pg_proc'::regclass AND d.objid=selected AND d.deptype='e' AND e.extname='laplace') THEN
  EXECUTE pg_catalog.format('ALTER EXTENSION laplace ADD FUNCTION %s',selected::regprocedure);
 END IF;
END
$source_grammar_function$;
