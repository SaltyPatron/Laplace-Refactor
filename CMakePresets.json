{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Laplace Linux development",
      "generator": "Ninja",
      "binaryDir": "/opt/laplace/work/laplace-refactor/build/${sourceDirName}/linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "LAPLACE_UNICODE_SOURCE_ROOT": "/vault/Data/UCD/Public/UCD/latest",
        "LAPLACE_ISO_639_SOURCE_ROOT": "/vault/Data/ISO639",
        "LAPLACE_CILI_SOURCE_ROOT": "/vault/Data/CILI"
      }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Laplace Linux address and undefined behavior checks",
      "inherits": "linux-dev",
      "binaryDir": "/opt/laplace/work/laplace-refactor/build/${sourceDirName}/linux-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev"
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "linux-dev",
      "configurePreset": "linux-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:check_initialization_order=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ]
}
