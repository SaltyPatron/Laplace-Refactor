-- Prove the packaged native binding upgrade on a real extension installation.
-- Every metadata change below rolls back; original native object OIDs survive.
CREATE TEMP TABLE highway_revalidation_bindings_before AS
SELECT row_to_json(p)::text AS function_record, row_to_json(t)::text AS type_record
FROM pg_catalog.pg_proc p CROSS JOIN pg_catalog.pg_type t
WHERE p.oid='laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric)'::regprocedure
  AND t.oid='laplace.highway_registry_revalidation_result'::regtype;
CREATE TEMP TABLE highway_revalidation_binding_checks(check_name text PRIMARY KEY);

BEGIN;
ALTER EXTENSION laplace DROP FUNCTION laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric);
DROP FUNCTION laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric);
ALTER EXTENSION laplace DROP TYPE laplace.highway_registry_revalidation_result;
DROP TYPE laplace.highway_registry_revalidation_result;
\ir @CMAKE_BINARY_DIR@/integrations/postgresql/extension/share/extension/laplace-public-readback.sql
\ir @CMAKE_BINARY_DIR@/integrations/postgresql/extension/share/extension/laplace-public-readback.sql
DO $verify_upgrade$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_proc p
        JOIN pg_catalog.pg_depend d ON d.objid=p.oid AND d.classid='pg_catalog.pg_proc'::regclass
        JOIN pg_catalog.pg_extension e ON e.oid=d.refobjid AND d.refclassid='pg_catalog.pg_extension'::regclass
        WHERE p.oid='laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric)'::regprocedure
          AND e.extname='laplace' AND d.deptype='e' AND p.proowner=e.extowner
          AND p.prosrc='laplace_pg_highway_registry_revalidate_committed' AND NOT p.prosecdef
          AND p.proacl IS NOT NULL
          AND NOT EXISTS (SELECT 1 FROM pg_catalog.aclexplode(p.proacl) a WHERE a.grantee=0 AND a.privilege_type='EXECUTE')) THEN
        RAISE EXCEPTION 'existing extension did not receive exact private native revalidation binding';
    END IF;
END $verify_upgrade$;
ROLLBACK;
INSERT INTO highway_revalidation_binding_checks VALUES('repeated-native-binding-upgrade');
\echo LAPLACE_HIGHWAY_REVALIDATION_BINDING_UPGRADE_OK

DO $reject_binding_corruption$
DECLARE
    program text := pg_catalog.pg_read_file('@CMAKE_BINARY_DIR@/integrations/postgresql/extension/share/extension/laplace-public-readback.sql');
    detected boolean;
BEGIN
    detected := false;
    BEGIN
        ALTER TYPE laplace.highway_registry_revalidation_result RENAME ATTRIBUTE verification_receipt TO corrupted_receipt;
        EXECUTE program;
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM NOT LIKE '%result type members differ%' THEN RAISE; END IF;
        detected := true;
    END;
    IF NOT detected THEN RAISE EXCEPTION 'renamed native result member was accepted'; END IF;
    INSERT INTO highway_revalidation_binding_checks VALUES('renamed-result-member-rejected');
    RAISE NOTICE 'LAPLACE_HIGHWAY_REVALIDATION_BINDING_REJECTED renamed-result-member';
    detected := false;
    BEGIN
        ALTER FUNCTION laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric) SECURITY DEFINER;
        EXECUTE program;
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM NOT LIKE '%not the owned native extension function%' THEN RAISE; END IF;
        detected := true;
    END;
    IF NOT detected THEN RAISE EXCEPTION 'elevated native verifier was accepted'; END IF;
    INSERT INTO highway_revalidation_binding_checks VALUES('security-definer-function-rejected');
    RAISE NOTICE 'LAPLACE_HIGHWAY_REVALIDATION_BINDING_REJECTED security-definer-function';
    detected := false;
    BEGIN
        ALTER EXTENSION laplace DROP FUNCTION laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric);
        EXECUTE program;
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM NOT LIKE '%not the owned native extension function%' THEN RAISE; END IF;
        detected := true;
    END;
    IF NOT detected THEN RAISE EXCEPTION 'unowned native verifier was accepted'; END IF;
    INSERT INTO highway_revalidation_binding_checks VALUES('detached-extension-function-rejected');
    RAISE NOTICE 'LAPLACE_HIGHWAY_REVALIDATION_BINDING_REJECTED detached-extension-function';
    detected := false;
    BEGIN
        ALTER INDEX laplace.composition_execution_receipt_staged_stream_idx
            RENAME TO composition_execution_receipt_staged_stream_saved;
        CREATE INDEX composition_execution_receipt_staged_stream_idx
            ON laplace.composition_execution_receipt(producer_receipt);
        EXECUTE program;
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM NOT LIKE '%composition receipt index differs%' THEN RAISE; END IF;
        detected := true;
    END;
    IF NOT detected THEN RAISE EXCEPTION 'wrong receipt lookup index was accepted'; END IF;
    INSERT INTO highway_revalidation_binding_checks VALUES('wrong-receipt-index-rejected');
    RAISE NOTICE 'LAPLACE_HIGHWAY_REVALIDATION_BINDING_REJECTED wrong-receipt-index';
END $reject_binding_corruption$;

DO $verify_metadata_unchanged$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM highway_revalidation_bindings_before b
        JOIN pg_catalog.pg_proc p ON p.oid='laplace.highway_registry_revalidate_committed(laplace.execution_context,numeric)'::regprocedure
        JOIN pg_catalog.pg_type t ON t.oid='laplace.highway_registry_revalidation_result'::regtype
        WHERE row_to_json(p)::text=b.function_record AND row_to_json(t)::text=b.type_record) THEN
        RAISE EXCEPTION 'rollback binding verification changed installed metadata';
    END IF;
END $verify_metadata_unchanged$;
DROP TABLE highway_revalidation_bindings_before;
