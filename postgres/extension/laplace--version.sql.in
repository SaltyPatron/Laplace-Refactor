CREATE SCHEMA @LAPLACE_PG_SCHEMA@;

CREATE TYPE @LAPLACE_PG_SCHEMA@.execution_context AS (
    epochs bytea[],
    authority_fingerprint bytea,
    memory_bytes bigint,
    cpu_slots integer,
    io_slots integer,
    epoch_mask bigint,
    framework_major smallint,
    framework_minor smallint,
    flags integer
);

CREATE TABLE @LAPLACE_PG_SCHEMA@.execution_receipt (
    receipt_id bytea PRIMARY KEY CHECK (octet_length(receipt_id) = 32),
    context_fingerprint bytea NOT NULL CHECK (octet_length(context_fingerprint) = 32),
    program_fingerprint bytea NOT NULL CHECK (octet_length(program_fingerprint) = 32),
    input_fingerprint bytea NOT NULL CHECK (octet_length(input_fingerprint) = 32),
    output_fingerprint bytea NOT NULL CHECK (octet_length(output_fingerprint) = 32),
    instruction_count bigint NOT NULL CHECK (instruction_count >= 0),
    executed_instruction_count bigint NOT NULL CHECK (
        executed_instruction_count >= 0
        AND executed_instruction_count <= instruction_count
    ),
    isa_major smallint NOT NULL CHECK (isa_major >= 0),
    isa_minor smallint NOT NULL CHECK (isa_minor >= 0),
    receipt_detail integer NOT NULL CHECK (receipt_detail >= 0),
    status integer NOT NULL CHECK (status >= 0),
    item_count bigint NOT NULL CHECK (item_count > 0),
    opcode integer NOT NULL CHECK (opcode > 0),
    recorded_at timestamptz NOT NULL DEFAULT clock_timestamp(),
    recorded_by name NOT NULL DEFAULT current_user
);

CREATE DOMAIN @LAPLACE_PG_SCHEMA@.content_id_128 AS bytea
    CHECK (octet_length(VALUE) = 16);
CREATE DOMAIN @LAPLACE_PG_SCHEMA@.record_id_256 AS bytea
    CHECK (octet_length(VALUE) = 32);

CREATE TYPE @LAPLACE_PG_SCHEMA@.entity_record AS (
    entity_id bytea,
    identity_witness bytea
);

CREATE TYPE @LAPLACE_PG_SCHEMA@.physicality_record AS (
    physicality_id bytea,
    entity_id bytea,
    physicality_type integer,
    vertex_class integer,
    recipe_version integer,
    structural_form integer,
    dimension_count integer,
    flags integer,
    recipe_fingerprint bytea,
    geometry_epoch bytea,
    trajectory_fingerprint bytea,
    centroid_x double precision,
    centroid_y double precision,
    centroid_z double precision,
    centroid_m double precision,
    radius double precision,
    logical_count numeric(20, 0),
    vertex_count numeric(20, 0)
);

-- This is a transport continuation for one Physicality.  It is assembled into
-- physicality.trajectory before canonical publication and is never a durable
-- semantic row family.
CREATE TYPE @LAPLACE_PG_SCHEMA@.physicality_trajectory_segment_record AS (
    physicality_id bytea,
    vertex_index numeric(20, 0),
    carrier bytea,
    constituent_entity_id bytea,
    logical_ordinal numeric(20, 0),
    metadata bigint,
    atom bigint,
    packed_ordinal integer,
    run_length integer,
    tier smallint,
    has_atom boolean
);

CREATE TYPE @LAPLACE_PG_SCHEMA@.attestation_record AS (
    attestation_id bytea,
    entity_id bytea,
    physicality_id bytea,
    source_fingerprint bytea,
    context_fingerprint bytea,
    source_ordinal numeric(20, 0),
    flags integer,
    attestation_kind integer
);

CREATE TYPE @LAPLACE_PG_SCHEMA@.consensus_record AS (
