[Unit]
Description=Laplace Refactor cognition service (laplace-runner user manager)
ConditionPathExists=/opt/laplace/receipts/bootstrap/cognition-user-service.json
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0002
Environment=TMPDIR=/build/laplace/work/refactor-scratch
Environment=TMP=/build/laplace/work/refactor-scratch
Environment=TEMP=/build/laplace/work/refactor-scratch
ExecStartPre=/opt/laplace/runtime/refactor/pgsql-18/bin/pg_isready --host=/opt/laplace/runtime/postgresql/refactor --port=55433 --dbname=laplace_refactor --username=laplace_app --timeout=5
ExecStart=/opt/laplace/runtime/refactor/bin/laplace-cognition-service --socket /opt/laplace/runtime/laplace-cognition.sock
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
