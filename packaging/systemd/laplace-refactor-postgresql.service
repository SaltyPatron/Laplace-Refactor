# Installed once by scripts/setup-host.sh. Product CI never rewrites this unit.
# /opt/laplace/runtime/refactor is an atomic laplace-runner-owned symlink to the
# package generation currently being proved/served. /opt/laplace/current remains the
# post-proof committed package identity.
[Unit]
Description=Laplace Refactor PostgreSQL product cluster
After=local-fs.target
RequiresMountsFor=/opt/laplace/pgdata/refactor /var/lib/pgwal /pgtemp
ConditionPathExists=/opt/laplace/runtime/refactor/pgsql-18/bin/postgres
ConditionPathExists=/opt/laplace/pgdata/refactor/data/PG_VERSION

[Service]
Type=simple
User=laplace-runner
Group=laplace-runner
RuntimeDirectory=laplace-refactor-postgresql
RuntimeDirectoryMode=0770
ExecStart=/opt/laplace/runtime/refactor/pgsql-18/bin/postgres -D /opt/laplace/pgdata/refactor/data -c config_file=/etc/laplace/instances/refactor/postgresql.conf
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=180
TimeoutStopSec=120
Restart=on-failure
RestartSec=2
UMask=0027
LimitNOFILE=65536
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=MKL_DYNAMIC=FALSE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/laplace/runtime /opt/laplace/pgdata/refactor /var/lib/pgwal/refactor /pgtemp/refactor /opt/laplace/receipts/postgresql/refactor /var/log/laplace/postgresql/refactor /etc/laplace/instances/refactor
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
