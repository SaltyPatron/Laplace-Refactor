<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <Target Name="RequireLaplaceGeneratedIsa" BeforeTargets="BeforeCompile">
    <Error Condition="'$(GeneratedIsaSource)' == ''" Text="GeneratedIsaSource is required." />
    <Error Condition="!Exists('$(GeneratedIsaSource)')" Text="Generated ISA source does not exist: $(GeneratedIsaSource)" />
    <Error Condition="'$(GeneratedHighwaySource)' == ''" Text="GeneratedHighwaySource is required." />
    <Error Condition="!Exists('$(GeneratedHighwaySource)')" Text="Generated highway source does not exist: $(GeneratedHighwaySource)" />
  </Target>
  <ItemGroup>
    <Compile Include="$(GeneratedIsaSource)" Link="Generated/IsaContract.g.cs" />
    <Compile Include="$(GeneratedHighwaySource)" Link="Generated/HighwayContract.g.cs" />
  </ItemGroup>
</Project>
