{
  "schema": "laplace.product-host-contract/v1",
  "version": "1.0.0",
  "service_identity": {
    "user": "laplace-runner",
    "group": "laplace-runner",
    "home": "/var/lib/agents/laplace-runner",
    "shell": "/usr/sbin/nologin",
    "system": true
  },
  "directories": [
    {
      "path": "/build/laplace/runner",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "2750",
      "purpose": "persistent runner build package receipt and request state"
    },
    {
      "path": "/etc/laplace",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "root-owned product and instance configuration"
    },
    {
      "path": "/etc/laplace/connections",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "typed client routing selections without embedded semantic behavior"
    },
    {
      "path": "/etc/laplace/instances",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "parent for cluster-activation-owned PostgreSQL instance configuration"
    },
    {
      "path": "/opt/laplace/deployment",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "immutable activation gateway generations"
    },
    {
      "path": "/opt/laplace/pgdata",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "persistent PostgreSQL state parent owned by the product service identity"
    },
    {
      "path": "/opt/laplace/pgdata/refactor",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "parent for cluster-activation-owned refactor data and perfcache directories"
    },
    {
      "path": "/opt/laplace/receipts",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "persistent product receipt root"
    },
    {
      "path": "/opt/laplace/receipts/postgresql",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "parent for cluster-activation-owned PostgreSQL instance receipts"
    },
    {
      "path": "/opt/laplace/releases",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "immutable content-addressed product releases"
    },
    {
      "path": "/opt/laplace/sources",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "immutable verified standards and configured source package inputs"
    },
    {
      "path": "/pgtemp",
      "owner": "root",
      "group": "root",
      "mode": "0755",
      "purpose": "parent for cluster-activation-owned PostgreSQL temporary state"
    },
    {
      "path": "/var/lib/agents/laplace-runner",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "service identity home without an interactive shell"
    },
    {
      "path": "/var/lib/pgwal",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0700",
      "purpose": "parent for cluster-activation-owned PostgreSQL WAL directories"
    },
    {
      "path": "/var/log/laplace",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "persistent Laplace service log root"
    },
    {
      "path": "/var/log/laplace/postgresql",
      "owner": "laplace-runner",
      "group": "laplace-runner",
      "mode": "0750",
      "purpose": "parent for cluster-activation-owned PostgreSQL instance logs"
    }
  ],
  "modules": {
    "gateway_contract": "contracts/product-activation-gateway.json",
    "cluster_contract": "contracts/postgresql-cluster.json",
    "gateway_installer": "tools/delivery/install_product_activation_gateway.py",
    "gateway_executable": "/opt/laplace/deployment/current/bin/laplace-product-activate",
    "product_builder": "tools/product/build-package.py",
    "distribution_controller": "tools/delivery/product_distribution.py",
    "installer_root": "/build/laplace/runner/product/installers",
    "cluster_controller": "tools/postgresql/clusterctl.py",
    "host_contract": "contracts/postgresql-host.json",
    "host_controller": "tools/postgresql/hostctl.py",
    "default_instance_request": "contracts/instances/refactor.json"
  },
  "lifecycle": {
    "install": "converge host identity and parent roots install immutable gateway then execute one signed whole-product request",
    "initial_run": "the install request lets cluster activation create and own instance leaf state then activates package cluster Unicode and Highway and returns durable receipt identities",
    "repair": "converge host identity parent roots and gateway then exact-replay the signed product request without replacing database state",
    "verify": "perform read-only identity parent-root gateway and optional product-result verification",
    "instance_state_owner": "cluster activation module",
    "manual_hotfixes": false
  }
}
