    },
    {
      "id": "definition",
      "match": {"element": "Definition", "text": true},
      "emit": {"kind": "typed-testimony", "relation": "definition", "subject": "ancestor:Synset@id", "object": "text-content"}
    },
    {
      "id": "example",
      "match": {"element": "Example", "text": true},
      "emit": {"kind": "typed-testimony", "relation": "example", "subject": "ancestor:Synset@id", "object": "text-content", "preserve_attributes": ["source"]}
    },
    {
      "id": "sense-relation",
      "match": {"element": "SenseRelation", "attributes": ["relType", "target"]},
      "emit": {"kind": "typed-relation", "relation": "attribute:relType", "subject": "ancestor:Sense@id", "object_namespace": "https://en-word.net/id/", "object": "attribute:target", "preserve_attributes": ["type"]}
    },
    {
      "id": "synset-relation",
      "match": {"element": "SynsetRelation", "attributes": ["relType", "target"]},
      "emit": {"kind": "typed-relation", "relation": "attribute:relType", "subject": "ancestor:Synset@id", "object_namespace": "https://en-word.net/id/", "object": "attribute:target"}
    },
    {
      "id": "syntactic-behaviour",
      "match": {"element": "SyntacticBehaviour", "attributes": ["id", "subcategorizationFrame"]},
      "emit": {"kind": "typed-observation", "role": "syntactic-behaviour", "identity": "attribute:id", "value": "attribute:subcategorizationFrame"}
    },
    {
      "id": "pronunciation",
