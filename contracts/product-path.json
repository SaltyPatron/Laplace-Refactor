{
  "schema": "laplace.product-path/v1",
  "issue": 54,
  "purpose": "Select the exact proof surfaces required by a change without converting unavailable physical evidence into success.",
  "hosted_only_patterns": [
    ".gitattributes",
    ".gitignore",
    "README.md",
    "docs/**"
  ],
  "default_class": "product-semantic",
  "default_evidence": [
    "hosted",
    "custom-stack"
  ],
  "class_rules": [
    {
      "id": "postgresql",
      "patterns": [
        "integrations/postgresql/**",
        "tools/postgresql/**",
        "contracts/postgresql-build.json",
        "contracts/postgresql-cluster.json",
        "contracts/postgresql-persistence.json",
        "contracts/unicode-postgresql.json",
        ".github/workflows/postgresql-product.yml",
        "tests/postgresql_product_proof_tests.py"
      ],
      "exclude_patterns": [],
      "evidence": [
        "postgresql-product"
      ]
    },
    {
      "id": "package",
      "patterns": [
        "dependencies/**",
        "tools/dependencies/**",
        "tools/product/**",
        "tools/delivery/**",
        "tools/receipt_store.cpp",
        "tests/package_product_proof_tests.py",
        "tests/receipt_store_test.cmake",
        "tests/registry.d/receipt_store.json",
        ".github/workflows/package-product.yml",
        "contracts/product-package.json",
        "contracts/product-activation-gateway.json",
        "contracts/runtime-package.json",
        "contracts/runtime-dependencies.json"
      ],
      "exclude_patterns": [
        "tools/delivery/product_path.py"
      ],
      "evidence": [
        "package-product"
      ]
    },
    {
      "id": "managed",
      "patterns": [
        "managed/**",
        "Directory.Build.props"
      ],
      "exclude_patterns": [],
      "evidence": []
    },
    {
      "id": "native",
      "patterns": [
        "engine/**",
        "cmake/**",
        "CMakeLists.txt",
        "CMakePresets.json",
        "tools/*.c",
        "tools/*.cc",
        "tools/*.cpp",
        "tools/*.h",
        "tools/*.hpp"
      ],
      "exclude_patterns": [],
      "evidence": []
    },
    {
      "id": "contract",
      "patterns": [
        "contracts/**",
        "requirements/**",
        "evidence/**",
        "state/**"
      ],
      "exclude_patterns": [],
      "evidence": []
    },
    {
      "id": "ci-test",
      "patterns": [
        ".github/workflows/**",
        "tests/**",
        "tools/tests/**"
      ],
      "exclude_patterns": [],
      "evidence": []
    }
  ],
  "evidence": [
    {
      "id": "hosted",
      "implemented": true,
      "check": "hosted-proof",
      "meaning": "requirements, generated-contract drift, clean-room native builds, registered tests, and hosted mutation checks"
    },
    {
      "id": "custom-stack",
      "implemented": true,
      "check": "custom-stack-proof",
      "meaning": "laplace-runner oneAPI PostgreSQL native managed and source-estate integration proof"
    },
    {
      "id": "postgresql-product",
      "implemented": true,
      "check": "postgresql-product-proof",
      "meaning": "exact current-change product package executed as an isolated PostgreSQL 18.6 cluster with live required-object inode and digest proof, fresh Laplace schema and epoch-state readback, and durable BLAKE3 receipts; this merge proof is not product activation"
    },
    {
      "id": "package-product",
      "implemented": true,
      "check": "package-product-proof",
      "meaning": "exact current-change product package composition, isolated immutable installation and replay verification, with raw package and installation receipt bytes retained in the persistent laplace-runner BLAKE3 receipt store"
    }
  ],
  "fail_closed": {
    "unknown_path": "Treat as product-semantic and require hosted plus custom-stack evidence.",
    "missing_provider": "Fail product-path; an unimplemented required evidence provider cannot be interpreted as skipped success.",
    "runner_unavailable": "Remain queued or fail; physical runner loss cannot produce green semantic evidence."
  }
}
