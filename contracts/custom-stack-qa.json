{
  "schema": "laplace.custom-stack-qa/v1",
  "issue": 118,
  "purpose": "Select only the expensive physical QA boundaries implicated by the changed product behavior while preserving a shared custom-stack core and failing a selected lane at its first terminal result.",
  "registry_profile": "custom-stack",
  "execution": {
    "core": "all tests eligible for the custom-stack registry profile except explicitly isolated physical-boundary tests",
    "selected_physical": "only isolated tests whose QA profile is selected by the exact changed paths",
    "stop_on_failure": true,
    "build_once": true,
    "later_operator_cancellation_cannot_reclassify_recorded_failure": true
  },
  "isolated_tests": [
    {
      "ctest_name": "postgres.composition-whole-boundary-measurement",
      "profile": "composition-boundary",
      "order": 10,
      "resource_class": "postgresql-representative-boundary",
      "reason": "measured whole-boundary composition performance and persistence proof"
    },
    {
      "ctest_name": "postgres.composition-whole-boundary-receipt-contract",
      "profile": "composition-boundary",
      "order": 11,
      "resource_class": "postgresql-representative-boundary",
      "reason": "receipt verification for the measured composition boundary"
    },
    {
      "ctest_name": "postgres.unicode-root-persistence-contract",
      "profile": "unicode-root-boundary",
      "order": 20,
      "resource_class": "postgresql-full-unicode-root",
      "reason": "complete Unicode root PostgreSQL persistence proof"
    },
    {
      "ctest_name": "postgres.source-admission-whole-route-contract",
      "profile": "source-admission-generic",
      "order": 30,
      "resource_class": "postgresql-source-admission",
      "reason": "generic source-admission whole-route proof"
    },
    {
      "ctest_name": "postgres.iso-639-source-admission-whole-route-contract",
      "profile": "source-iso639",
      "order": 40,
      "resource_class": "postgresql-real-source-profile",
      "reason": "real ISO 639 source-profile whole-route proof"
    },
    {
      "ctest_name": "postgres.cili-source-admission-whole-route-contract",
      "profile": "source-cili",
      "order": 50,
      "resource_class": "postgresql-real-source-profile",
      "reason": "real CILI source-profile whole-route proof"
    }
  ],
  "selection_rules": [
    {
      "id": "composition-boundary",
      "patterns": [
        "contracts/composition.json",
        "cmake/LaplaceCompositionContract.cmake",
        "engine/include/laplace/composition.h",
        "engine/src/composition.cpp",
        "postgres/extension/src/composition_pg.c",
        "tests/composition_tests.cpp",
        "tests/postgres/composition_*"
      ],
      "profiles": ["composition-boundary"]
    },
    {
      "id": "unicode-root-boundary",
      "patterns": [
        "contracts/unicode-*.json",
        "cmake/LaplaceUnicode*.cmake",
        "engine/include/laplace/unicode_*.h",
        "engine/src/unicode_*.c",
        "engine/src/unicode_*.cpp",
        "postgres/extension/src/unicode_*.c",
        "tests/unicode_*.cpp",
        "tests/postgres/unicode_*",
        "tools/postgresql/unicodectl.py"
      ],
      "profiles": ["unicode-root-boundary"]
    },
    {
      "id": "source-admission-generic",
      "patterns": [
        "contracts/source-admission.json",
        "contracts/source-profile-*.json",
        "contracts/tabular-source.json",
        "contracts/world-admission-execution.json",
        "cmake/LaplaceSource*.cmake",
        "cmake/LaplaceTabular*.cmake",
        "cmake/LaplaceWorldAdmissionContract.cmake",
        "engine/include/laplace/source_profile.h",
        "engine/include/laplace/tabular_source.h",
        "engine/include/laplace/world_admission.h",
        "engine/src/source_profile.c",
        "engine/src/tabular_source.cpp",
        "engine/src/world_admission.c",
        "postgres/extension/src/source_admission_pg.c",
        "postgres/extension/src/source_profile_pg.c",
        "postgres/extension/src/world_admission_pg.c",
        "tests/source_profile_tests.cpp",
        "tests/tabular_source_tests.cpp",
        "tests/world_admission_tests.cpp",
        "tests/postgres/source_admission_*",
        "tests/postgres/source_profile_*",
        "tests/postgres/world_admission_*",
        "tools/contracts/generate-tabular-source-profile.py",
        "tools/sources/acquire-tabular-source.py"
      ],
      "profiles": ["source-admission-generic", "source-iso639", "source-cili"]
    },
    {
      "id": "source-iso639",
      "patterns": [
        "contracts/sources/iso-639-*.json",
        "tests/iso_639_*",
        "tests/postgres/iso_639_*"
      ],
      "profiles": ["source-iso639"]
    },
    {
      "id": "source-cili",
      "patterns": [
        "contracts/sources/cili-*.json",
        "tests/cili_*",
        "tests/postgres/cili_*"
      ],
      "profiles": ["source-cili"]
    }
  ],
  "fail_closed": {
    "unknown_or_unmatched_change": "run the shared custom-stack core but do not invent an expensive source/profile boundary",
    "isolated_test_missing_from_registry": "reject the QA plan",
    "selected_profile_without_isolated_test": "reject the QA plan",
    "selected_test_missing_from_ctest": "reject before execution",
    "terminal_test_failure_timeout_or_crash": "record the primary terminal lane result and stop before any later selected physical test"
  }
}
