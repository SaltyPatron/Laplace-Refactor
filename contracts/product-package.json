{
  "schema": "laplace.product-package-contract/v1",
  "version": "1.0.0",
  "postgresql": {
    "receipt_schema": "laplace.postgresql-package-receipt/v2",
    "version": "PostgreSQL 18.6",
    "logical_prefix": "/opt/laplace/current/pgsql-18"
  },
  "laplace": {
    "logical_prefix": "/opt/laplace/current",
    "required_installed_providers": [
      "intel-oneapi-runtime",
      "onetbb",
      "onemkl"
    ],
    "required_capabilities": {
      "app_effect_boundary": 1,
      "exact_loaded_object_identity": 1,
      "topology_bound_processor_allocation": 1
    }
  },
  "build": {
    "root": "/build/laplace/build/product",
    "stage_root": "/build/laplace/stage/product",
    "configuration": "Release",
    "testing": false,
    "dotnet_bindings": false,
    "c_compiler": "/opt/intel/oneapi/compiler/2026.1/bin/icx",
    "cxx_compiler": "/opt/intel/oneapi/compiler/2026.1/bin/icpx",
    "blake3_source": "/opt/laplace/external/source-generations/f9fa2f2723d506d5a678f0bba204f67ab6a483ad09509199ce5c3f1a7ef92fd7/blake3/c",
    "parallel_jobs": 6
  },
  "host_build_provider": {
    "receipt_schema": "laplace.postgresql-host-build-provider/v1",
    "verifier": "tools/postgresql/host-provider.py",
    "sandbox_executable": "/usr/bin/bwrap",
    "additional_receipted_files": [
      "/var/lib/dpkg/status"
    ]
  },
  "package": {
    "manifest_schema": "laplace.package-manifest/v1",
    "release_root": "/opt/laplace/releases",
    "required_loaded_objects": [
      "pgsql-18/bin/postgres",
      "pgsql-18/lib/laplace_pg.so",
      "pgsql-18/lib/pg_stat_statements.so",
      "lib/liblaplace_engine.so.2.0.0"
    ],
    "required_files": [
      "pgsql-18/bin/initdb",
      "pgsql-18/bin/pg_config",
      "pgsql-18/bin/pg_ctl",
      "pgsql-18/bin/pg_isready",
      "pgsql-18/bin/postgres",
      "pgsql-18/bin/psql",
      "pgsql-18/lib/laplace_pg.so",
      "pgsql-18/lib/pg_stat_statements.so",
      "pgsql-18/share/extension/laplace.control",
      "pgsql-18/share/extension/laplace--1.0.0.sql",
      "lib/liblaplace_engine.so.2.0.0"
    ]
  },
  "runtime_closure": {
    "verifier": "tools/dependencies/elf-closure.py",
    "schema": "laplace.elf-closure/v1",
    "tool_version": "1.0.0",
    "search_subdirectories": [
      "pgsql-18/lib",
      "lib"
    ],
    "required_zero_summary_fields": [
      "unresolved_edge_count",
      "parse_error_count",
      "discovery_error_count",
      "resolution_conflict_count",
      "root_abi_family_collision_count"
    ]
  },
  "activation": {
    "requires_postgresql_build_input_closure": true,
    "requires_postgresql_runtime_provider_qualification": true,
    "requires_recursive_elf_closure": true,
    "requires_product_build_input_closure": true,
    "requires_clean_repository": true
  }
}
