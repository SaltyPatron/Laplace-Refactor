    "algorithm": [
      "M=1<<31",
      "for Q=M;Q>1;Q>>=1: P=Q-1; for axis=0..3: if X[axis]&Q then X[0]^=P else t=(X[0]^X[axis])&P;X[0]^=t;X[axis]^=t",
      "for axis=1..3: X[axis]^=X[axis-1]",
      "t=0;for Q=M;Q>1;Q>>=1:if X[3]&Q then t^=Q-1",
      "for axis=0..3:X[axis]^=t",
      "interleave-transpose-MSB-bit-plane-first-in-axis-order"
    ],
